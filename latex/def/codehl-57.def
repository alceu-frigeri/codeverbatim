%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-57}
  {
     name        = {codehl-57} ,
     prefix      = {codehl} ,
     date        = {2026/11/01} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~57}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%


\codehl_lang_def:nn { TeX } 
  {
    info / note  =
     {
       Base / Usual ~ TeX ~ Language ~ setup.
     }  ,
    identifier               =      { texcs } { \\ } { }  ,
    comment ~ line           =      {1} { \% } { }  ,
  }
  
\codehl_lang_def:nn { TeX.l3 } 
  {
    info / note  =
     {
       This ~ includes ~ an ~ _ ~ as ~ an ~ oletter,
       ~ and ~ sets ~ alphanumeric ~ true. ~
       Better ~ approach: ~ capture ~ it ~ as ~ a ~ letter ~ (codeverbatim).
        ~ and ~ use ~ TeX ~ base ~ language ~ instead.
     }  ,
    based ~ on               =      { TeX }  ,
    %%% Argh!
    %%% It's better to just redefine those chars as letter (codeverbatim)
    %%% this (TeX.l3) is just 'in case' for those that don't want to adjust
    %%% the verbatim code before using it.
    oletter                  =      { \_ }  ,
    digits*                  =      { } ,
    alphanumeric             =      true ,
  }

\codehl_lang_def:nn { TeX.l3sign }   %%% changed by Alceu - 2026/11
  {
    info / note  =
     {
       This ~ includes ~ _ and ~ : ~ as ~ oletter,
       ~ and ~ sets ~ alphanumeric ~ true. ~
       Better ~ approach: ~ capture ~ them ~ as ~ letter ~ (codeverbatim),
        ~ and ~ use ~ TeX ~ base ~ language ~ instead.
     }  ,
    based ~ on               =      { TeX }  ,
    %%% Argh!
    %%% It's better to just redefine those chars as letter (codeverbatim)
    %%% this (TeX.l3sign) is just 'in case' for those that don't want to adjust
    %%% the verbatim code before using it.
    oletter                  =      { \_: }  ,
    digits*                  =      { } ,
    alphanumeric             =      true ,
  }


%%
%% Aliases
%%



%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut
