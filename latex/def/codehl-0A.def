%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-0A}
  {
     name        = {codehl-0A} ,
     prefix      = {codehl} ,
     date        = {2026/11/18} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~0A}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { scala.3.10 }
  {
    %%%
    info / note  =
     {
       scala ~ 3.10 ~base ~ Language. ~ Some ~ references~\\
        https://docs.scala-lang.org/scala3/~\\
        https://scala-lang.org/files/archive/spec/
     }  ,
    %%%

    comment ~ line           =      {1} { //    }                 { }  ,
    comment                  =      {2} { /*    } { */  }         { }  ,

    string                   =      {1} { '     }         {     } { }  ,
    string                   =      {1} { "     }         { \\  } { }  ,
    string                   =      {1} { `     }         {     } { }  ,
    
    delimited ~ string       =      {2} { """   } { """ } {     } { }  ,
    delimited ~ string       =      {2} { s"    } { "   } { \\  } { }  ,
    delimited ~ string       =      {2} { f"    } { "   } { \\  } { }  ,
    delimited ~ string       =      {2} { raw"  } { "   } {     } { }  ,

    identifier               =      { annotation } { \@ }         { }  ,    

    alphanumeric             =      true  ,
    oletter                  =      { \_\$ }  ,
  }

\codehl_keyset_def:nn { scala.3.10 }
  {
    %%%
    info / note  =
     {
       scala ~ 3.10 ~base ~ Language. ~ Some ~ references~\\
        https://docs.scala-lang.org/scala3/~\\
        https://scala-lang.org/files/archive/spec/
     }  ,
    %%%

    keywd                    =      {1}
      { %%% hard keywords
        abstract, case, catch, class, def, do, else, enum, 
        export, extends, false, final, finally, for, given, if, 
        implicit, import, lazy, match, new, null, object, override, 
        package, private, protected, return, sealed, super, then, 
        throw, trait, true, try, type, val, var, while, with, yield
      }  ,
      %%% !!also keywords!!
      %%% :, =, <-, =>, <:, >:, #, @, =>>, ?=>
    keywd                    =      {2}
      {  %%% soft keywords
        as, derives, end, extension, infix, inline, 
        opaque, open, transparent, using
      }  ,
      %%% !!also keywords!!
      %%% |, *, +, -
    annotation               =      {1}
      {
        %%% Core / Compiler annotations
        tailrec, switch, inline, noinline, native, strictfp, static, 
        targetName, threadUnsafe, varargs, elidable, specialized, 
        unspecialized, unused, nowarn, compileTimeOnly, constructorOnly, 
        showAsInfix, alpha, publicInBinary, unroll
        %%% Deprecation & documentation
        deprecated, deprecatedInheritance, deprecatedOverriding, 
        deprecatedName, implicitNotFound, implicitAmbiguous
        %%% Concurrency / JVM interop
        transient, volatile, SerialVersionUID, throws
        %%%  experimental
        main, experimental, MacroAnnotation, retains, retainsByName, 
        retainsCap, capability, stableNull, transparentTrait
        %%% Meta-annotations
        beanGetter, beanSetter, field, getter, setter, param, 
        companionClass, companionMethod, companionObject, defaultArg, 
        superArg, superFwdArg
        %%% Unchecked family
        unchecked, uncheckedVariance, uncheckedStable, 
        uncheckedCaptures, uncheckedOverride
      }
  }

%%
%% Aliases
%%

\codehl_lang_alias:nn   { scala } { scala.3.10 }
\codehl_keyset_alias:nn { scala } { scala.3.10 }

%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut


