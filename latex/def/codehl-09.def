%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-09}
  {
     name        = {codehl-09} ,
     prefix      = {codehl} ,
     date        = {2026/11/18} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~09}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { JavaScript }
  {
    %%%
    info / note  =
     {
       JavaScript ~ base ~ Language. ~ Some ~ references~\\
        https://developer.mozilla.org/en-US/docs/Web/JavaScript~\\
        https://262.ecma-international.org/
     }  ,
    %%%

    comment ~ line           =      {1} { //  }                 { }  ,
    comment                  =      {2} { /*  } { */  }         { }  ,
    
    string                   =      {1} { '   }         { \\  } { }  ,
    string                   =      {1} { "   }         { \\  } { }  ,
    string                   =      {2} { `   }         { \\  } { }  ,
    delimited ~ string       =      {3} { """ } { """ } {     } { }  ,
    
    alphanumeric             =      true  ,
    oletter                  =      { \_\$ }  ,
  }

\codehl_keyset_def:nn { JavaScript }
  {
    %%%
    info / note  =
     {
       JavaScript ~ base ~ Language. ~ Some ~ references~\\
        https://developer.mozilla.org/en-US/docs/Web/JavaScript~\\
        https://262.ecma-international.org/
     }  ,
    %%%

    keywd                    =      {1}
      {
        await, break, case, catch, class, const, continue, debugger, 
        default, delete, do, else, enum, export, extends, false, finally, 
        for, function, if, import, in, instanceof, new, null, return, 
        super, switch, this, throw, true, try, typeof, var, void, while, 
        with, yield,
        implements, interface, let, package, private, protected, public, static,
      }  ,
    keywd                    =      {1}
      {
        abstract, boolean, byte, char, double, final, float, goto, int, long, 
        native, short, synchronized, throws, transient, volatile,
        arguments, as, async, eval from, get, of, set, 
        null, 
      }  ,
  }

%%
%% Aliases
%%

%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut


