%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-08}
  {
     name        = {codehl-08} ,
     prefix      = {codehl} ,
     date        = {2026/11/01} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~08}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { php.8 }
  {
    info / note  =
     {
       php ~ 8 ~  base ~ Language. Some ~ references~\iow_newline:
        https://www.php.net/
     }  ,
    based ~ on               =      { html }  ,
    comment ~ line           =      {2} { // }  { tagged }  ,
    comment ~ line           =      {2} { \# }  { tagged }  ,
    comment                  =      {2} { /* } { */ } { tagged }  ,
    string                   =      {2} { '    } { \\ } { tagged }  ,
    string                   =      {2} { "    } { \\ } { tagged }  ,
    oletter                  =      { \_ }  ,
    alphanumeric             =      true  ,
    case ~ sensitive         =      true  ,
    tagged ~ area            =      { php }  { <?    } { ?> } { nestable }  ,  %%% err, this is a 'echo' shortcut ... 
    tagged ~ area            =      { php }  { <?php } { ?> } { nestable }  ,
    identifier               =      { php-vars } { \$ } { tagged }  ,
  }
%%% TODO:
%%% heredoc <<'something'
%%% hint: $, @, %, & * => letter ??  


\codehl_keyset_def:nn { php.8 }
  {
    info / note  =
     {
       php ~ 8 ~  base ~ Language. Some ~ references~\iow_newline:
        https://www.php.net/
     }  ,
    php                      =      {1}
      {  %%% elements
        abstract, and, array, as, break, callable, case, catch, 
        class, clone, const, continue, declare, default, die, 
        do, echo, else, elseif, empty, enddeclare, endfor, 
        endforeach, endif, endswitch, endwhile, eval, exit, extends, 
        final, finally, fn, for, foreach, function, global, goto, if, 
        implements, include, include_once, instanceof, insteadof, interface, 
        isset, list, match, namespace, new, or, print, private, protected, 
        public, readonly, require, require_once, return, static, switch, 
        throw, trait, try, unset, use, var, while, xor, yield, yield from
      }  ,
    php                      =      {2}
      {  %%% magic constants
        __LINE__, __FILE__, __DIR__, __FUNCTION__, __CLASS__, 
        __TRAIT__, __METHOD__, __PROPERTY__, __NAMESPACE__, 
      }  ,
    php-vars                 =      {3}
      {  %%% supper globals
        GLOBALS, _SERVER, _GET, _POST, _FILES, 
        _REQUEST, _SESSION, _ENV, _COOKIE, 
        argc, argv, http_response_header, php_errormsg
      }  ,
  }

