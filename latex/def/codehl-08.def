        mysqli_fetch_fields,  mysqli_fetch_field_direct,  mysqli_fetch_lengths,  
        mysqli_fetch_all,  mysqli_fetch_array,  mysqli_fetch_assoc,  
        mysqli_fetch_object,  mysqli_fetch_row,  mysqli_field_count,  
        mysqli_field_seek,  mysqli_field_tell,  mysqli_free_result,  
        mysqli_get_connection_stats,  mysqli_get_client_stats,  
