\codehl_keyset_def:nn { TeX.pdfTeX }
  {
    %%%
    info / note  =
     {
       Primitives  ~ commands ~ ~\\
       https://ctan.org/pkg/pdftex
     }  ,
    %%%

    based ~ on               =      { TeX.primitives }  ,
    
    texcs                    =      {2}
      { %%% not all of them...
        pdfadjustspacing, pdfannot, pdfcatalog, pdfcolorstack, 
        pdfcolorstackinit, pdfcompresslevel, pdfcreationdate, 
        pdfdecimaldigits, pdfdest, pdfdestmargin, pdfdraftmode, 
        pdfendlink, pdfendthread, pdffakespace, pdffontattr, pdffontname, 
        pdffontobjnum, pdffontexpand, pdfgamma, pdfgentounicode, 
        pdfglyphtounicode, pdfhorigin, pdfimageapplygamma, 
        pdfimagegamma, pdfimagehicolor, pdfimageresolution, 
        pdfincludechars, pdfinclusioncopyfonts, pdfinclusionerrorlevel, 
        pdfinfo, pdfinfoomitdate, pdfinterwordspaceoff, 
        pdfinterwordspaceon, pdflastannot, pdflastlink, 
        pdflastobj, pdflastxform, pdflastximage, pdflastximagepages, 
        pdflastxpos, pdflastypos, pdflinkmargin, pdfliteral, pdfmapfile, 
        pdfmapline, pdfmatch, pdfmdfivesum, pdfminorversion, 
        pdfmajorversion, pdfnames, pdfnoligatures, pdfnormaldeviate, 
        pdfobj, pdfobjcompresslevel, pdfomitcharset, pdfoutline, 
        pdfoutput, pdfpageattr, pdfpagebox, pdfpageheight, 
        pdfpageref, pdfpageresources, pdfpagesattr, pdfpagewidth, 
        pdfpkmode, pdfpkresolution, pdfprimitive, pdfprotrudechars, 
        pdfrefobj, pdfrefxform, pdfrefximage, pdfreplacefont, 
        pdfrestore, pdfretval, pdfsave, pdfsavepos, pdfsetmatrix, 
        pdfsetrandomseed, pdfshellescape, pdfstartlink, pdfstartthread, 
        pdfstrcmp, pdftexbanner, pdftexrevision, pdftexversion, 
        pdfthread, pdfthreadmargin, pdftrailer, pdftrailerid, 
        pdftracingfonts, pdftrailer, pdfunescapehex, pdfuniformdeviate, 
        pdfuniqueresname, pdfvorigin, pdfxform, pdfximage
      }  ,
  }
  
\codehl_keyset_def:nn { TeX.luaTeX }
  {
    %%%
    info / note  =
     {
       Primitives  ~ commands ~ ~\\
       https://ctan.org/pkg/pdftex
     }  ,
    %%%

    based ~ on               =      { TeX.primitives }  ,
    
    texcs                    =      {2}
      { %%% not all of them...
        directlua, latelua, lateluafunction, luaescapestring, 
        luafunction, luafunctioncall, luadef, luabytecode, luabytecodecall,
        %%% Attribute
        attribute, attributedef, boxattribute,
        %%% Catcode
        catcodetable, initcatcodetable, savecatcodetable,
        %%% Tokens
        expanded, immediateassignment, immediateassigned, glet, 
        letcharcode, toksapp, tokspre, etoksapp, etokspre, 
        gtoksapp, gtokspre, xtoksapp, xtokspre, csstring, 
        begincsname, lastnamedcs, scantextokens, clearmarks, 
        alignmark, aligntab, ifcondition,
        %%% 
        bodydir, pagedir, textdir, mathdir, pardir, 
        breakafterdirmode, shapemode, hyphenationmin, 
        boundary, noboundary, protrusionboundary, wordboundary,
        %%% 
        Uleft, Uright, Uhextensible, 
        Uvextensible, Uchar, Ucharcat, Ustack,
        %%% 
        pdfextension, pdfvariable, pdffeedback,
        %%%
        outputmode, draftmode, pagewidth, pageheight, pxdimen, 
        protrudechars, adjustspacing, copyfont, fontexpand,
        expandglyphsinfont, ignoreligaturesinfont, normaldeviate, 
        uniformdeviate, randomseed, setrandomseed, savepos, 
        lastxpos, lastypos, fontid, setfontid, noligs, nokerns, 
        nospaces, gleaders, nohrule, novrule, outputbox, vpack, hpack, 
        tpack, suppressfontnotfounderror, suppresslongerror, 
        suppressifcsnameerror, suppressoutererror, 
        suppressmathparerror, suppressprimitiveerror, 
        luatexbanner, luatexversion, luatexrevision, 
      }  ,
  }


\codehl_keyset_def:nn { TeX.common }
  {
    %%%
    info / note  =
     {
       some  ~ common ~ commands ~ ~\\
       https://ctan.org/pkg/pdftex
     }  ,
    %%%

    texcs                    =      {1}
      { %%% not all of them...
        documentclass, usepackage, 
        title, author, date, maketitle, 
        tableofcontents, listoffigures, listoftables,

        part, section, subsection, subsubsection, 
        paragraph, subparagraph,

        label, ref, pageref, cite, nocite,

        textbf, textit, texttt, textsc, textsf, textsl, 
        emph, textnormal, textrm, textup, tiny, 
        scriptsize, footnotesize, small, normalsize, 
        large, Large, LARGE, huge, Huge, 

        item, caption, centering, 
        includegraphics,
        linewidth, textwidth, textheight

        newpage, clearpage, cleardoublepage, pagebreak, 
        nopagebreak, linebreak, nolinebreak, newline, 
        hspace, vspace, hfill, vfill, indent, 
        noindent, par,

        footnote, footnotemark, footnotetext, marginpar,

        mbox, makebox, fbox, framebox, parbox, minipage, raisebox, rule,

        setlength, addtolength, settowidth, settoheight, 
        settodepth, newcounter, setcounter, addtocounter, 
        value, arabic, roman, Roman, alph, Alph, fnsymbol,

        newcommand, renewcommand, providecommand, newenvironment, 
        renewenvironment, newtheorem,

        today, newline, smallskip, medskip, bigskip, 
        quad, qquad, ldots, dots, LaTeX, TeX, 
        protect, typeout, typein
      }  ,
    keywd                    =      {1}
      {  %%% environments
        itemize, enumerate, description, document, center, 
        flushleft, flushright, quote, quotation, verse, 
        verbatim, abstract, figure, table, equation, eqnarray,
      }
  }

