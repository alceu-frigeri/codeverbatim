%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-0E}
  {
     name        = {codehl-0E} ,
     prefix      = {codehl} ,
     date        = {2026/11/18} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~0E}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { COBOL.74 }
  {
    %%%
    info / note  =
     {
       COBOL ~ 74 ~ base ~ Language. ~ Some ~ references~\\
       https://www.mainframemaster.com/tutorials/cobol~\\
       https://en.wikipedia.org/wiki/COBOL~\\
       https://pubs.opengroup.org/onlinepubs/009680799/toc.pdf~\\
       https://web.archive.org/web/20170110012927/http://www.cobolstandard.info/~\\
       https://web.archive.org/web/20160822165122/http://www.cobolstandard.info/wg4/wg4.html
     }  ,
    %%%

    comment ~ line ~ at      =      {1} { *  } { 7 }     { } ,
    
    string                   =      {1} { "  }       { } { }  ,
    string                   =      {1} { '  }       { } { }  ,

    identifier               =      { pragma } { >> }    { }  ,

    alphanumeric             =      true  ,
    digits                   =      { -\_ }  ,

    case ~ sensitive         =      upper ~ case  ,
  }

\codehl_lang_def:nn { COBOL.85 }
  {
    %%%
    info / note  =
     {
       COBOL ~ 85 ~ based ~ on ~ COBOL ~74
     }  ,
    %%%

    based ~ on               =      { COBOL.74 }  ,
    
    delimited ~ string       =      {1} { X" } { " } { } { } ,
    delimited ~ string       =      {1} { X' } { ' } { } { } ,
  }

\codehl_lang_def:nn { COBOL.02 }
  {
    %%%
    info / note  =
     {
       COBOL ~ 02 ~ based ~ on ~ COBOL ~ 85
     }  ,
    %%%

    based ~ on               =      { COBOL.85 }  ,
    
    comment ~ line           =      {1} { *> } { } ,
    
    delimited ~ string       =      {1} { N" } { " } { } { } ,
    delimited ~ string       =      {1} { N' } { ' } { } { } ,
    
  }

\codehl_keyset_def:nn { COBOL.74 }
  {
    %%%
    info / note  =
     {
       COBOL ~ 74 ~ base ~ Language. ~ Some ~ references~\\
       https://www.mainframemaster.com/tutorials/cobol~\\
       https://en.wikipedia.org/wiki/COBOL~\\
       https://pubs.opengroup.org/onlinepubs/009680799/toc.pdf~\\
       https://web.archive.org/web/20170110012927/http://www.cobolstandard.info/~\\
       https://web.archive.org/web/20160822165122/http://www.cobolstandard.info/wg4/wg4.html
     }  ,
    %%%

    keywd!                    =      {1}
      { 
        ACCEPT, ACCESS, ADD, ADVANCING, AFTER, ALL, ALPHABETIC, ALSO, 
        ALTER, ALTERNATE, AND, ARE, AREA, AREAS, ASCENDING, ASSIGN, 
        AT, AUTHOR, BEFORE, BLANK, BLOCK, BOTTOM, BY, CALL, CANCEL, 
        CD, CF, CH, CHARACTER, CHARACTERS, CLOCK-UNITS, CLOSE, COBOL, 
        CODE, CODE-SET, COLLATING, COLUMN, COMMA, COMMUNICATION, COMP, 
        COMPUTATIONAL, COMPUTE, CONFIGURATION, CONTAINS, CONTROL, CONTROLS, 
        COPY, CORR, CORRESPONDING, COUNT, CURRENCY, DATA, DATE-COMPILED, 
        DATE-WRITTEN, DAY, DE, DEBUG-CONTENTS, DEBUG-ITEM, DEBUG-LINE, 
        DEBUG-NAME, DEBUG-SUB-1, DEBUG-SUB-2, DEBUG-SUB-3, DEBUGGING,
         DECIMAL-POINT, DECLARATIVES, DELETE, DELIMITED, DELIMITER, 
         DEPENDING, DESCENDING, DESTINATION, DETAIL, DISABLE, DISPLAY, DIVIDE, 
         DIVISION, DOWN, DUPLICATES, EGI, ELSE, EMI, ENABLE, END, ENDING, 
         ENTER, ENVIRONMENT, EOP, EQUAL, ERROR, ESI, EVERY, EXCEPTION, 
         EXIT, EXTEND, FD, FILE, FILE-CONTROL, FILLER, FINAL, FIRST, 
         FOOTING, FOR, FROM, GENERATE, GIVING, GO, GREATER, GROUP, 
         HEADING, HIGH-VALUE, HIGH-VALUES, I-O, I-O-CONTROL, 
         IDENTIFICATION, IF, IN, INDEX, INDEXED, INDICATE, 
         INITIAL, INITIATE, INPUT, INPUT-OUTPUT, INSPECT, INSTALLATION, 
         INTO, INVALID, IS, JUST, JUSTIFIED, KEY, LABEL, LAST, LEADING, 
         LEFT, LENGTH, LESS, LIMIT, LIMITS, LINAGE, LINAGE-COUNTER, LINE, 
         LINE-COUNTER, LINES, LINKAGE, LOCK, LOW-VALUE, LOW-VALUES, MEMORY, 
         MERGE, MESSAGE, MODE, MODULES, MOVE, MULTIPLE, MULTIPLY, NATIVE, 
         NEGATIVE, NEXT, NO, NOT, NUMBER, NUMERIC, OBJECT-COMPUTER, OCCURS, 
         OF, OFF, OMITTED, ON, OPEN, OPTIONAL, OR, ORGANIZATION, OUTPUT, 
         OVERFLOW, PAGE, PAGE-COUNTER, PERFORM, PF, PH, PIC, PICTURE, 
         PLUS, POINTER, POSITION, POSITIVE, PRINTING, PROCEDURE, PROCEED, 
         PROGRAM, PROGRAM-ID, QUEUE, QUOTE, QUOTES, RANDOM, RD, READ, 
         RECEIVE, RECORD, RECORDS, REDEFINES, REEL, REFERENCES, RELATIVE, 
         RELEASE, REMAINDER, REMOVAL, RENAMES, REPLACING, REPORT, REPORTING, 
         REPORTS, RERUN, RESERVE, RESET, RETURN, REVERSED, REWIND, 
         REWRITE, RF, RH, RIGHT, ROUNDED, RUN, SAME, SD, SEARCH, SECTION, 
         SECURITY, SEGMENT, SEGMENT-LIMIT, SELECT, SEND, SENTENCE, SEPARATE, 
         SEQUENCE, SEQUENTIAL, SET, SIGN, SIZE, SORT, SORT-MERGE, SOURCE, 
         SOURCE-COMPUTER, SPACE, SPACES, SPECIAL-NAMES, STANDARD, START, 
         STATUS, STOP, STRING, SUBTRACT, SUM, SYMBOLIC, SYNC, SYNCHRONIZED, 
         TABLE, TALLY, TALLYING, TAPE, TERMINAL, TERMINATE, TEXT, THAN, 
         THROUGH, THRU, TIME, TIMES, TO, TOP, TRAILING, TYPE, UNIT, UNSTRING, 
         UNTIL, UP, UPON, USAGE, USE, USING, VALUE, VALUES, VARYING, WHEN, 
         WITH, WORDS, WORKING-STORAGE, WRITE, ZERO, ZEROES, ZEROS,
      }  ,
    pragma!                   =      {1}
      {
        COPY, REPLACE, USE, ENTER, EJECT, SKIP, TITLE,
      }
  }

\codehl_keyset_def:nn { COBOL.85 }
  {
    %%%
    info / note  =
     {
       COBOL ~ 85 ~ based ~ on ~ COBOL ~74
     }  ,
    %%%


    based ~ on                =      { COBOL.74 }  ,
    keywd!                    =      {1}
      { 
        ALPHABET, ALPHABETIC-LOWER, ALPHABETIC-UPPER, ALPHANUMERIC, 
        ALPHANUMERIC-EDITED, ANY, BINARY, CLASS, COMMON, CONTENT, CONTINUE, 
        CONVERTING, DAY-OF-WEEK, END-ADD, END-CALL, END-COMPUTE, END-DELETE, 
        END-DIVIDE, END-EVALUATE, END-IF, END-MULTIPLY, END-PERFORM, END-READ, 
        END-RETURN, END-REWRITE, END-SEARCH, END-START, END-STRING, 
        END-SUBTRACT, END-UNSTRING, END-WRITE, EVALUATE, EXTERNAL, FALSE, 
        GLOBAL, INITIALIZE, ORDER, OTHER, PACKED-DECIMAL, PASSWORD, PURGE, 
        REFERENCE, REPLACE, STANDARD-1, STANDARD-2, TEST, THEN, TRUE,
      }  ,
  }

\codehl_keyset_def:nn { COBOL.02 }
  {
    %%%
    info / note  =
     {
       COBOL ~ 02 ~ based ~ on ~ COBOL ~85
     }  ,
    %%%


    based ~ on                =      { COBOL.85 }  ,
    keywd!                    =      {1}
      { 
        ACTIVE-CLASS, ADDRESS, ALIGNED, ALLOCATE, AS, BASED, 
        BINARY-CHAR, BINARY-DOUBLE, BINARY-LONG, BINARY-SHORT, 
        BIT, BOOLEAN, CLASS-ID, CONDITION, CONSTANT, DATA-POINTER, 
        FACTORY, FLOAT-EXTENDED, FLOAT-LONG, FLOAT-SHORT, FREE, 
        FUNCTION, FUNCTION-ID, GET, INHERITS, INTERFACE, INTERFACE-ID, 
        INVOKE, LOCAL-STORAGE, METHOD, METHOD-ID, NATIONAL, NATIONAL-EDITED, 
        OBJECT, OBJECT-REFERENCE, OVERRIDE, PROGRAM-POINTER, PROPERTY, 
        PROTOTYPE, RAISE, RAISING, REPOSITORY, RETURNING, SELF, SET, 
        SHARING, SUPER, SYSTEM-DEFAULT, TYPEDEF, UNIVERSAL, USER-DEFAULT, 
        VAL-STATUS, VALIDATE,
      }  ,
    pragma!                   =      {1}
      {
        DEFINE, IF, ELSE, END-IF, EVALUATE, DISPLAY, CALL-CONVENTION, COBOL-WORDS, SOURCE,
      }
  }

%%
%% Aliases
%%

\codehl_lang_alias:nn   { COBOL } { COBOL.02 }
\codehl_keyset_alias:nn { COBOL } { COBOL.02 }

%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut


