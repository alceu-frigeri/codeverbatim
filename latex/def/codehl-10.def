%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-10}
  {
     name        = {codehl-10} ,
     prefix      = {codehl} ,
     date        = {2026/11/18} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~10}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { Rust.1.99 }
  {
    %%%
    info / note  =
     {
       Rust ~ 1.99 ~ base ~ Language. ~ Some ~ references~\\
       https://doc.rust-lang.org/std/index.html~\\
       https://rust-lang.org
     }  ,
    %%%

    comment ~ line           =      {1} { //        }                     { } ,
    comment                  =      {1} { /*        }  { */     }         { nestable } ,
    comment ~ line           =      {1} { ///       }                     { } ,
    comment                  =      {1} { /**       }  { */     }         { nestable } ,
    comment ~ line           =      {1} { //!       }                     { } ,
    comment                  =      {1} { /*!       }  { */     }         { nestable } ,

    string                   =      {1} { '         }             { \\  } { }  ,
    string                   =      {1} { "         }             { \\  } { }  ,
    
    delimited ~ string       =      {1} { r"        } { "       } { \\  } { }  ,
    delimited ~ string       =      {1} { r#"       } { "#      } { \\  } { }  ,
    delimited ~ string       =      {1} { r##"      } { "##     } { \\  } { }  ,
    delimited ~ string       =      {1} { r###"     } { "###    } { \\  } { }  ,
    delimited ~ string       =      {1} { r####"    } { "####   } { \\  } { }  ,
    delimited ~ string       =      {1} { r#####"   } { "#####  } { \\  } { }  ,
    
    delimited ~ string       =      {1} { b'        } { '       } { \\  } { }  ,
    delimited ~ string       =      {1} { b"        } { "       } { \\  } { }  ,
    delimited ~ string       =      {1} { br"       } { "       } { \\  } { }  ,
    delimited ~ string       =      {1} { br#"      } { "#      } { \\  } { }  ,
    delimited ~ string       =      {1} { br##"     } { "##     } { \\  } { }  ,
    delimited ~ string       =      {1} { br###"    } { "###    } { \\  } { }  ,
    delimited ~ string       =      {1} { br####"   } { "####   } { \\  } { }  ,
    delimited ~ string       =      {1} { br#####"  } { "#####  } { \\  } { }  ,
    
    delimited ~ string       =      {1} { c'        } { '       } { \\  } { }  ,
    delimited ~ string       =      {1} { c"        } { "       } { \\  } { }  ,
    delimited ~ string       =      {1} { cr"       } { "       } { \\  } { }  ,
    delimited ~ string       =      {1} { cr#"      } { "#      } { \\  } { }  ,
    delimited ~ string       =      {1} { cr##"     } { "##     } { \\  } { }  ,
    delimited ~ string       =      {1} { cr###"    } { "###    } { \\  } { }  ,
    delimited ~ string       =      {1} { cr####"   } { "####   } { \\  } { }  ,
    delimited ~ string       =      {1} { cr#####"  } { "#####  } { \\  } { }  ,

    tagged ~ area            =      { attrib     }    { \#[     } { ]\# } { }  ,
    tagged ~ area            =      { attrib     }    { \#![    } { ]\# } { }  ,
    
    alphanumeric             =      true  ,
    oletter                  =      { \_ }  ,
  }

\codehl_keyset_def:nn { Rust.1.99 }
  {
    %%%
    info / note  =
     {
       Rust ~ 1.99 ~ base ~ Language. ~ Some ~ references~\\
       https://doc.rust-lang.org/std/index.html~\\
       https://rust-lang.org
     }  ,
    %%%

    keywd                    =      {1}
      { 
        _, as, async, await, break, const, continue, 
        crate, dyn, else, enum, extern, false, fn, for, 
        if, impl, in, let, loop, match, mod, move, mut, pub, 
        ref, return, self, Self, static, struct, super, trait, 
        true, type, unsafe, use, where, while, 
        abstract, become, box, do, final, gen, macro, 
        override, priv, try, typeof, unsized, virtual, yield, 
        macro_rules, static, raw, safe, union, 
      }  ,
    attrib                   =      {1}
      {
        allow, cfg, cfg_attr, deny, deprecated, derive, doc, 
        export_name, link, link_section, must_use, no_mangle, 
        repr, test, warn
      }  ,
  }

\codehl_keyset_def:nn { Rust.1.99.core }
  {
    %%%
    info / note  =
     {
       Rust ~ 1.99 ~ core ~ crate
     }  ,
    %%%

    keywd                    =      {2}
      { %%% types
        array, bool, char, f32, f64, fn, i8, i16, i32, 
        i64, i128, isize, pointer, reference, slice, str, tuple, 
        u8, u16, u32, u64, u128, unit, usize
      }  ,
    keywd                    =      {3}
      { %%% modules
        alloc, any, arch, array, ascii, borrow, cell, char, 
        clone, cmp, convert, default, error, f32, f64, ffi, 
        fmt, future, hash, hint, iter, marker, mem, net, num, 
        ops, option, panic, pin, prelude, primitive, ptr, range, 
        result, slice, str, sync, task, time
      }  ,
    keywd                    =      {4}
      { %%% macros
        assert, assert_eq, assert_matches, assert_ne, 
        cfg, cfg_select, column, compile_error, concat, 
        debug_assert, debug_assert_eq, debug_assert_matches, 
        debug_assert_ne, env, file, format_args, include, include_bytes, 
        include_str, line, matches, module_path, option_env, panic, 
        stringify, todo, unimplemented, unreachable, write, writeln
      }  ,
  }

\codehl_keyset_def:nn { Rust.1.99.alloc }
  {
    %%%
    info / note  =
     {
       Rust ~ 1.99 ~ alloc ~ crate
     }  ,
    %%%

    keywd                    =      {3}
      { %%% modules
        alloc, borrow, boxed, collections, ffi, fmt, rc, slice, str, 
        string, sync, task, vec
      }  ,
    keywd                    =      {4}
      { %%% macros
        format, vec, 
      }  ,
  }

\codehl_keyset_def:nn { Rust.1.99.std }
  {
    %%%
    info / note  =
     {
       Rust ~ 1.99 ~ std ~ crate.
     }  ,
    %%%

    based ~ on               =      { Rust.1.99.core , Rust.1.99.alloc }  ,
    
    keywd                    =      {3}
      { %%% modules
        backtrace, env, fs, io, os, path, process, thread,
        token_stream, 
      }  ,
    keywd                    =      {4}
      { %%% macros
        dbg, eprint, eprintln, is_x86_feature_detected, 
        print, println, thread_local, 
      }  ,
  }

\codehl_keyset_def:nn { Rust.1.99.all }
  {
    %%%
    info / note  =
     {
       Rust ~ 1.99 ~ std ~plus ~ std ~ crate.
     }  ,
    %%%

    based ~ on               =      { Rust.1.99 , Rust.1.99.std }  ,
  }

%%
%% Aliases
%%

\codehl_lang_alias:nn   { Rust } { Rust.1.99 }
\codehl_keyset_alias:nn { Rust } { Rust.1.99 }

%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut


