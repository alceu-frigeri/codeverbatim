%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-0B}
  {
     name        = {codehl-0B} ,
     prefix      = {codehl} ,
     date        = {2026/11/18} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~0B}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { VB.6 }
  {
    %%%
    info / note  =
     {
       VisualBasic ~ 6 ~(classic) ~ base ~ Language. ~ Some ~ references~\\
        https://learn.microsoft.com/en-us/previous-versions/visualstudio/visual-basic-6/~\\
        https://en.wikipedia.org/wiki/Visual_Basic_(classic)
     }  ,
    %%%

    comment ~ line           =      {1} { '   }           { }  ,
    comment ~ line           =      {1} { Rem }           { }  ,
    
    string                   =      {1} { "   }       { } { }  ,

    identifier               =      { pragma    } { \# }  { }  ,

    alphanumeric             =      true  ,
    oletter                  =      { \_ }  ,
    
    case ~ sensitive         =      false  ,
  }

\codehl_lang_def:nn { VB.17 }
  {
    %%%
    info / note  =
     {
       VisualBasic ~ 17 ~based ~ on VisualBasic ~ 6 ~ (classic)
     }  ,
    %%%

    based ~ on               =      { VB.6 }  ,
    
    delimited ~ string       =      {1} { \$" } { " } { } { } ,
  }

\codehl_keyset_def:nn { VB.6 }
  {
    %%%
    info / note  =
     {
       VisualBasic ~ 6 ~(classic) ~ base ~ Language. ~ Some ~ references~\\
        https://learn.microsoft.com/en-us/previous-versions/visualstudio/visual-basic-6/~\\
        https://en.wikipedia.org/wiki/Visual_Basic_(classic)
     }  ,
    %%%

    keywd*                    =      {1}
      { 
        And, As, Boolean, ByRef, Byte, ByVal, Call, Case, Const, Currency, Date, 
        Declare, Dim, Do, Double, Each, Else, ElseIf, End, Enum, Erase, 
        Error, Event, Exit, False, For, Friend, Function, Get, GoSub, 
        GoTo, If, Implements, Input, Integer, Is, Let, Lib, Like, Long, 
        Loop, LSet, Me, Mod, New, Next, Not, Nothing, Object, On, Option, 
        Optional, Or, ParamArray, Private, Property, Public, RaiseEvent, 
        ReDim, Rem, Resume, Return, RSet, Select, Set, Single, Static, Step, 
        Stop, String, Sub, Then, To, True, Type, Until, Variant, Wend, While, 
        With, WithEvents, Xor
      }  ,
    pragma*                   =      {1}
      {  %%% "directives"
        Const, If, Then, ElseIf, Else, End
      }  ,
    keywd*                    =      {2}
      {  %%% "statement keywords"
        %%% Declaration / Definition statements
        Const, Declare, DefBool, DefByte, DefCur, DefDate, DefDbl, 
        DefDec, DefInt, DefLng, DefObj, DefSng, DefStr, DefVar, Dim, 
        Enum, Event, Friend, Function, Option, Private, Property, Public, 
        ReDim, Static, Sub, Type, WithEvents
        %%% Control flow / Decision statements
        Call, Case, Do, Else, ElseIf, End, Exit, For, GoSub, GoTo, 
        If, Loop, Next, On, Return, Select, Step, Then, To, Until, 
        Wend, While
        %%% Error handling
        Error, On Error, Resume
        %%% Assignment / Object statements
        Let, LSet, Mid, RSet, Set
        %%% Loop-related / Iteration
        Each, In
        %%% File I/O statements
        Close, Get, Input, Kill, Line Input, Lock, Name, Open, 
        Print, Put, Reset, Seek, Unlock, Width, Write
        %%% Miscellaneous executable statements
        AppActivate, Beep, ChDir, ChDrive, Date, DeleteSetting, DoEvents, 
        Erase, FileCopy, Load, MkDir, RaiseEvent, Randomize, Rem, RmDir, 
        SavePicture, SaveSetting, SendKeys, SetAttr, Stop, 
        Time, Unload, With
      }  ,
  }

\codehl_keyset_def:nn { VB.8 }
  {
    %%%
    info / note  =
     {
       VisualBasic ~ 8 ~(.NET) ~base ~ Language. ~ Some ~ references~\\
        https://learn.microsoft.com/en-us/dotnet/visual-basic/language-reference/keywords/~\\
        https://github.com/dotnet/vblang
        
     }  ,
    %%%

    keywd*                    =      {1}
      { 
        AddHandler, AddressOf, Alias, And, AndAlso, As, Boolean, ByRef, 
        Byte, ByVal, Call, Case, Catch, CBool, CByte, CChar, CDate, CDbl, 
        CDec, Char, CInt, Class, CLng, CObj, Const, Continue, CSByte, CShort, 
        CSng, CStr, CType, CUInt, CULng, CUShort, Date, Decimal, Declare, 
        Default, Delegate, Dim, DirectCast, Do, Double, Each, Else, ElseIf, 
        End, EndIf, Enum, Erase, Error, Event, Exit, False, Finally, For, 
        Friend, Function, Get, GetType, Global, GoSub, GoTo, Handles, If, 
        Implements, Imports, In, Inherits, Integer, Interface, Is, IsNot, 
        Let, Lib, Like, Long, Loop, Me, Mod, Module, MustInherit, 
        MustOverride, MyBase, MyClass, Namespace, Narrowing, New, 
        Next, Not, Nothing, NotInheritable, NotOverridable, Object, 
        Of, On, Operator, Option, Optional, Or, OrElse, Overloads, 
        Overridable, Overrides, ParamArray, Partial, Private, Property, 
        Protected, Public, RaiseEvent, ReadOnly, ReDim, REM, RemoveHandler, 
        Resume, Return, SByte, Select, Set, Shadows, Shared, Short, Single, 
        Static, Step, Stop, String, Structure, Sub, SyncLock, Then, Throw, 
        To, True, Try, TryCast, TypeOf, UInteger, ULong, UShort, Using, 
        Variant, Wend, When, While, Widening, With, WithEvents, 
        WriteOnly, Xor,
      }  ,
    keywd*                    =      {2}
      { %%% "statement keywords"
        AddHandler, Call, Class, Const, Declare, Delegate, Dim, Do, 
        End, Enum, Erase, Error, Event, Exit, For, Function, Get, 
        GoTo, If, Imports, Interface, Module, Namespace, On, Option, 
        Property, RaiseEvent, ReDim, Rem, RemoveHandler, Resume, Return, 
        Select, Set, Stop, Structure, Sub, SyncLock, Throw, Try, 
        Using, While, With,
      }  ,    
  }
  
\codehl_keyset_def:nn { VB.12 }
  {
    %%%
    info / note  =
     {
       VisualBasic ~ 12 ~(.NET) ~based ~ on ~ VB.8
        
     }  ,
    %%%

    based ~ on                =      { VB.8 }  ,
    keywd*                    =      {1}
      { 
        Aggregate, Async, Await, Distinct, From, Group, Into, 
        Iterator, Join, Key, Order, Skip, Take, Where, Yield,
      }  ,
    keywd*                    =      {2}
      { %%% "statement keywords"
        Async, Await, Continue, Iterator, Yield,
      }  ,    
  }

\codehl_keyset_def:nn { VB.17 }
  {
    %%%
    info / note  =
     {
       VisualBasic ~ 17 ~(.NET) ~based ~ on ~ VB.12
        
     }  ,
    %%%

    based ~ on                =      { VB.12 }  ,
  }

%%
%% Aliases
%%
\codehl_lang_alias:nn   { VisualBasicClassic } { VB.6 }
\codehl_keyset_alias:nn { VisualBasicClassic } { VB.6 }

\codehl_lang_alias:nn   { VisualBasic } { VB.17 }
\codehl_keyset_alias:nn { VisualBasic } { VB.17 }

%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut


