%%%==============================================================================
%%
%% Nota Bene:
%% Some languages 'got' an specific identifier
%%                  like ==> identifier = { pragma } { \# } { }
%%                    or ==> identifier = { texcs }  { \\ } { }
%%      this is a flexible way to declare keywords/pragmas instead
%%      of changing the catcode of some chars to letter
%%          main implication: some keyword/pragma's lists got split.
%%%==============================================================================

%%%%%%%
%%%  This save the current 'expl syntax' state
%%%%%%%
\hlExplFileTest
%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplFile {codehl-03}
  {
     name        = {codehl-03} ,
     prefix      = {codehl} ,
     date        = {2026/11/01} ,
     version     = {1.0} ,
     description = {codehighlight ~language ~definitions ~03}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\codehl_lang_def:nn { python.2.7 }
  {
    info / note  =
     {
       python ~ 2.7 ~ base ~ Language. Some ~ references~\iow_newline:
        https://docs.python.org/3/reference/lexical_analysis.html~\iow_newline:
        https://docs.python.org/3/library/keyword.html~\iow_newline:
        https://github.com/python/cpython/blob/main/Lib/keyword.py
     }  ,
    comment ~ line           =      {1} { \\\# } { }  ,
    string                   =      {1} { "     } { \\ } { }  ,
    string                   =      {2} { '     } { \\ } { }  ,
    string                   =      {1} { """   } { \\ } { }  ,
    string                   =      {2} { '''   } { \\ } { }  ,
    delimited ~ string       =      {3} { r"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { r"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { r'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { r'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { R"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { R"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { R'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { R'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { b"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { b"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { b'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { b'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { B"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { B"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { B'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { B'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { rb"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { rb""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { rb'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { rb''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { RB"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { RB""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { RB'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { RB''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { br"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { br""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { br'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { br''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { BR"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { BR""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { BR'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { BR''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { u"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { u"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { u'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { u'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { U"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { U"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { U'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { U'''  } { ''' } { \\ } { }  ,
    oletter                  =      { \_ }  ,
    alphanumeric             =      true  ,
  }

\codehl_lang_def:nn { python.3.0 }
  {
    info / note  =
     {
       python ~ 3.0 ~ based ~ on ~ python ~ 2.7
     }  ,
    based ~ on               =      { python.2.7 }  ,
  }
  

