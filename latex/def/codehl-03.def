\codehl_lang_def:nn { python.3.12 }
  {
    info / note  =
     {
       python ~ 3.12 ~ based ~ on ~ python ~ 3.6
     }  ,
    based ~ on               =      { python.3.6 }  ,
  }


\codehl_keyset_def:nn { python.2.7 }
  {
    info / note  =
     {
       python ~ 2.7 ~ base ~ Language. Some ~ references~\iow_newline:
        https://docs.python.org/3/reference/lexical_analysis.html~\iow_newline:
        https://docs.python.org/3/library/keyword.html~\iow_newline:
        https://github.com/python/cpython/blob/main/Lib/keyword.py
     }  ,
    keywd                    =      {1}
      {
        and, as, assert, break, class, continue, def, del, elif, 
        else, except, exec, finally, for, from, global, if, 
        import, in, is, lambda, not, or, pass, print, raise, 
        return, try, while, with, yield,
      }  ,
  }

\codehl_keyset_def:nn { python.3.0 }
  {
    info / note  =
     {
       python ~ 3.0 ~ based ~ on ~ python ~ 2.7
     }  ,
    based ~ on               =      { python.2.7 }  ,
    suppress ~ keywd         =      {1}
      {
        print, exec,
      }  ,
    keywd                    =      {1}
      {
        nonlocal, True, False, None,
      }  ,    
  }

\codehl_keyset_def:nn { python.3.6 }
  {
    info / note  =
     {
       python ~ 3.6 ~ based ~ on ~ python ~ 3.0
     }  ,
    based ~ on               =      { python.3.0 }  ,
    keywd                    =      {1}
      {
        async, await, 
      }  ,    
  }

\codehl_keyset_def:nn { python.3.12 }
  {
    info / note  =
     {
       python ~ 3.12 ~ based ~ on ~ python ~ 3.6
     }  ,
    based ~ on               =      { python.3.6 }  ,
    keywd                    =      {1}
      {
        match, case, _, type,
      }  ,    
  }

%%
%% Aliases
%%
%
\codehl_lang_alias:nn   { python } { python.3.12 }
\codehl_keyset_alias:nn { python } { python.3.12 }


%%%%%%%
%%%  This restore the 'expl syntax' state saved (hopefully) at the beginning
%%%%%%%
\hlExplFileOut
