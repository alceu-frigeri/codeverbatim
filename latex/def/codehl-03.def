    based ~ on               =      { python.3.0 }  ,
    delimited ~ string       =      {3} { f"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { f"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { f'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { f'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { F"    } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { F"""  } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { F'    } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { F'''  } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { fr"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { fr""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { fr'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { fr''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { FR"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { FR""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { FR'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { FR''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { rf"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { rf""" } { """ } { \\ } { }  ,
    delimited ~ string       =      {3} { rf'   } { '   } { \\ } { }  ,
    delimited ~ string       =      {3} { rf''' } { ''' } { \\ } { }  ,
    delimited ~ string       =      {3} { RF"   } { "   } { \\ } { }  ,
    delimited ~ string       =      {3} { RF""" } { """ } { \\ } { }  ,
