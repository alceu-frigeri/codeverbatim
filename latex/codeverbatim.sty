\pkginfograbProvidesExplPackage {codeverbatim}
  {
     name        = {codeverbatim} ,
     prefix      = {codeverb} ,
     date        = {2026/11/01} ,
     version     = {1.0} ,
     description = {Verbatim Environment for codelisting}
  }
