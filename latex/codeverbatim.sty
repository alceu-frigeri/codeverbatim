\cs_new_protected:Npn \__codeverb_opt_catcodes_default:
  {
    \seq_set_from_clist:Nn \l__codeverb_opt_other_seq
      {
        \~  , \     , \\    , \{    , \}    ,
        \#  , \&    , \$    , \^    , \_    ,
        \%  , \^^A  , \^^I  , \^^J  , \^^K
      }
    \seq_clear:N \l__codeverb_opt_letter_seq
    \tl_clear:N \l__codeverb_opt_cctab_tl
  }

\cs_new_protected:Npn \__codeverb_sanitize_list:nNn #1#2#3
  {
    \seq_set_from_clist:Nn \l__codeverb_tmpa_seq { #3 }
    \seq_map_inline:Nn \l__codeverb_tmpa_seq
      {
        \__codeverb_getchar:wNTF ##1 \q_stop \l__codeverb_tmpa_tl
          { % OK, just one char
            \seq_put_right:No #2 \l__codeverb_tmpa_tl
          }
          { % more than one char... rest being ignored
            \seq_put_right:No #2 \l__codeverb_tmpa_tl
            \msg_error:nnnn { codeverbatim / syntax } { single char }
              { san01 } { #1 }
          }
      }
  }


\cs_new_protected:Npn \__codeverb_ccset_new:n #1
  {
    \tl_if_empty:NTF \l__codeverb_opt_cctab_tl
      { \tl_clear:N \l__codeverb_tmpa_tl }
      {
        \tl_set:Ne  \l__codeverb_tmpa_tl
          {
            \exp_not:N \cctab_select:N \exp_not:c { \l__codeverb_opt_cctab_tl }
          }
      }
    \seq_if_empty:NF \l__codeverb_opt_other_seq
      {
        \seq_set_eq:cN { __codeverb_ #1 _other_seq }
          \l__codeverb_opt_other_seq

        \tl_put_right:Ne \l__codeverb_tmpa_tl
          {
            \exp_not:N \__codeverb_set_other:N \exp_not:c { __codeverb_ #1 _other_seq }
          }
      }
    \seq_if_empty:NF \l__codeverb_opt_letter_seq
      {
        \seq_set_eq:cN { __codeverb_ #1 _letter_seq }
          \l__codeverb_opt_letter_seq
        \tl_put_right:Ne \l__codeverb_tmpa_tl
          {
            \exp_not:N \__codeverb_set_letter:N \exp_not:c { __codeverb_ #1 _letter_seq }
          }
      }

    \cs_set_protected:cpe { __codeverb_ #1 _ccset: }
      {
        \exp_not:o \l__codeverb_tmpa_tl
      }

