\cs_new_protected:Npn \codeverb_sverb_on:
  {
    \bool_if:NTF \l__codeverb_sverb_on_bool
      {
        \msg_warning:nnn { codeverbatim } { sverb already on }
          {verbon:01}
      }
      {
        \bool_if:NTF \l__codeverb_sverb_build_bool
          { }
          {
    %\prop_show:N \l__codeverb_sverb_prop

            \seq_remove_duplicates:N \l__codeverb_sverb_seq
            \prop_clear:N \l__codeverb_sverb_patt_prop
            \prop_clear:N \l__codeverb_sverb_scan_prop
            \seq_clear:N \l__codeverb_sverb_self_activ_seq
            \int_zero:N \l__codeverb_sverb_patt_cnt_int
            \seq_map_inline:Nn \l__codeverb_sverb_seq
              {
                %%% the pattern might have been deleted \codeverb_sverb_undef:n
                %%%
                \prop_get:NnNTF \l__codeverb_sverb_prop { ##1 } \l__codeverb_tmpa_tl
                  {
                    \exp_last_unbraced:No
                      \__codeverb_sverb_patt_build:Nn \l__codeverb_tmpa_tl
                  }
                  { }
              }
            \int_zero:N \l__codeverb_sverb_cnti_int
            \prop_map_inline:Nn \l__codeverb_sverb_patt_prop
              {
                \int_incr:N \l__codeverb_sverb_cnti_int
                \int_zero:N \l__codeverb_sverb_cntii_int

                \seq_map_inline:Nn ##2
                  {
                    \__codeverb_sverb_onbuild:Nnnnn ####1
                  }

                \prop_put:Nne \l__codeverb_sverb_scan_prop
                  { ##1 }
                  {
                    { \exp_not:n { ##1 } }
                    { \exp_not:c { __codeverb_sverb_ \int_use:N \l__codeverb_sverb_cnti_int _activ_bool } }
                    { \exp_not:c { __codeverb_sverb_ \int_use:N \l__codeverb_sverb_cnti_int _catcode_tl } }
                    { \exp_not:c { __codeverb_sverb_ \int_use:N \l__codeverb_sverb_cnti_int . 0 _cs: } }
                    { \exp_not:c { __codeverb_sverb_ \int_use:N \l__codeverb_sverb_cnti_int . \int_use:N \l__codeverb_sverb_cntii_int _cs: } }
                  }
              }
            \bool_set_true:N \l__codeverb_sverb_build_bool
          }

        \cs_set:Npn \__codeverb_sverb_self_ccset:
          { \__codeverb_set_other:N \l__codeverb_sverb_self_activ_seq }

        \prop_map_inline:Nn \l__codeverb_sverb_scan_prop
          { \__codeverb_sverb_set_on:NNNNN ##2 }
        \bool_set_true:N \l__codeverb_sverb_on_bool
      }


