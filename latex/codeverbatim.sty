%%%%%%%
%%% #1 keys
%%% #2 active char, start pattern
%%% #3 end pattern
%%% #4 processing code
%%%%%%%
\cs_new_protected:Npn \codeverb_sverb_new:nnnn #1#2#3#4
  {
    \__codeverb_opt_catcodes_default:
    \keys_set:nn { codeverb / common keys }
      { #1 }


    \bool_if:NTF \l__codeverb_sverb_on_bool
      {
        \msg_err:nnn { codeverbatim } { sverb on err }
          { sverb01 }
      }
      {

        \int_gincr:N \g__codeverb_sverb_cnt_int

        \__codeverb_ccset_new:n { sverb_ \int_use:N \g__codeverb_sverb_cnt_int }

        \__codeverb_dlimit:nNN
          { #2 }
          \l__codeverb_tmpa_tl \l__codeverb_tmpb_tl

        \tl_set_eq:NN \l__codeverb_tmpe_tl \l__codeverb_tmpb_tl

        \__codeverb_regex_sanitize:N \l__codeverb_tmpe_tl

        \__codeverb_dlimit:nNN
          { #3 }
          \l__codeverb_tmpc_tl \l__codeverb_tmpd_tl

        \prop_put:Nee \l__codeverb_sverb_prop
          { \exp_not:o \l__codeverb_tmpa_tl \exp_not:o \l__codeverb_tmpb_tl }
          {
            { \exp_not:o \l__codeverb_tmpa_tl }
            {
              { \exp_not:o \l__codeverb_tmpa_tl }
              { \exp_not:o \l__codeverb_tmpe_tl }
              { \exp_not:o \l__codeverb_tmpc_tl \exp_not:o \l__codeverb_tmpd_tl }
              { \exp_not:n { #4 } }
              { \exp_not:c { __codeverb_sverb_ \int_use:N \g__codeverb_sverb_cnt_int _ccset: } }
            }
          }

        \seq_put_right:Ne \l__codeverb_sverb_seq
          { \exp_not:o \l__codeverb_tmpa_tl \exp_not:o \l__codeverb_tmpb_tl }

        \bool_set_false:N \l__codeverb_sverb_build_bool
%        \prop_show:N \l__codeverb_sverb_prop
      }
  }



