%%%%%%%
%%% This is defined both in
%%% codehl   => \__codehl_lang_get_dlimit:nNN
%%%             \__codehl_regex_sanitize:N
%%% codeverb => \__codeverb_get_dlimit:nNN
%%%             \__codeverb_regex_sanitize:N
%%%
%%% to avoid cross dependence
%%%%%%%

%%%%%%%
%%% those are all characters that have an special (regex) meaning
%%%%%%%
\regex_const:Nn \c__codeverb_tr_regex { ( [ \_ \| \. \+ \- \* \? \! \, \^ \$ \:  \[ \] \{ \} \( \) \\ ] ) }
\cs_new_protected:Npn \__codeverb_regex_sanitize:N
  { \regex_replace_all:NnN \c__codeverb_tr_regex { \\ \1 } }

\regex_const:Nn \c__codeverb_escape_regex { \\(.) }
\cs_new_protected:Npn \__codeverb_dlimit:nNN #1
  {
    \str_set:Nn \l__codeverb_tmpa_str { #1 }
    \tl_remove_all:Nn \l__codeverb_tmpa_str { ~ }
    \regex_replace_all:NnN \c__codeverb_escape_regex { \1 } \l__codeverb_tmpa_str
    \exp_last_unbraced:No \__codeverb_dlimit:wNN \l__codeverb_tmpa_str \q_stop
  }

\cs_new_protected:Npn \__codeverb_dlimit:wNN #1#2 \q_stop #3#4
  {
    \tl_set:Nn #3 { #1 }
    \tl_if_blank:nTF { #2 }
      { \tl_clear:N #4 }
      { \tl_set:Nn #4 { #2 } }
  }

%%%%%%%
%%% Bending the rules... this behaves as an usual conditional,
%%% though it isn't a standard one
%%%%%%%
\cs_new_protected:Npn \__codeverb_getchar:wNTF #1#2 \q_stop #3
  {
    \tl_set:Nn #3 { #1 }
    \tl_if_blank:nTF { #2 }
  }



