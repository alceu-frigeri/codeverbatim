%%%%%%%%%%%%%%%%%%%%%
%%%
%%% Using low level if's since it will process whatever code, a token (byte) at a time.
%%%
%%%%%%%%%%%%%%%%%%%%%

%%%%%%%
%%% 1st: nestable
%%% 2nd: 0:default, 1:tag only, 2:base only, 3:tr case
%%% 3rd: type 0:comment, 1:string, 2:both  <if nestable>
%%% 4th: col at
%%% 5th: case
%%%%%%%
\cs_new_protected:Npn \__codehl_lang_case_split:w #1#2.#3#4.#5
  {
    \int_if_zero:nTF { #1 }
      {
        \bool_set_false:N \l__codehl_lang_case_incmt_bool
        \bool_set_false:N \l__codehl_lang_case_instr_bool
        \bool_set_false:N \l__codehl_lang_case_nestable_bool
      }
      {
        \bool_set_true:N \l__codehl_lang_case_nestable_bool
        \if_case:w #3
            \bool_set_true:N  \l__codehl_lang_case_incmt_bool
            \bool_set_false:N \l__codehl_lang_case_instr_bool
          \or:
            \bool_set_false:N \l__codehl_lang_case_incmt_bool
            \bool_set_true:N  \l__codehl_lang_case_instr_bool
          \or:
            \bool_set_true:N  \l__codehl_lang_case_incmt_bool
            \bool_set_true:N  \l__codehl_lang_case_instr_bool
        \fi:
      }

    \if_case:w #2
        \bool_set_true:N   \l__codehl_lang_case_inbase_bool
        \bool_set_true:N   \l__codehl_lang_case_intag_bool
        \bool_set_false:N  \l__codehl_lang_case_intr_bool
      \or:
        \bool_set_false:N  \l__codehl_lang_case_inbase_bool
        \bool_set_true:N   \l__codehl_lang_case_intag_bool
        \bool_set_false:N  \l__codehl_lang_case_intr_bool
      \or:
        \bool_set_true:N   \l__codehl_lang_case_inbase_bool
        \bool_set_false:N  \l__codehl_lang_case_intag_bool
        \bool_set_false:N  \l__codehl_lang_case_intr_bool
      \or:
        \bool_set_false:N  \l__codehl_lang_case_inbase_bool
        \bool_set_false:N  \l__codehl_lang_case_intag_bool
        \bool_set_true:N   \l__codehl_lang_case_intr_bool
    \fi:

    \int_if_zero:nTF { #4 }
      { \bool_set_false:N \l__codehl_lang_case_colat_bool }
      { \bool_set_true:N  \l__codehl_lang_case_colat_bool }
    \tl_set:Nn \l__codehl_lang_case_case_tl  { #5 }
  }

\cs_new_protected:Npn \__codehl_lang_case_getx:w #1#2.#3#4.#5
  {
      \int_if_zero:nTF { #4 }
      { \bool_set_false:N \l__codehl_lang_case_colat_bool }
      { \bool_set_true:N  \l__codehl_lang_case_colat_bool }
    \tl_set:Nn \l__codehl_lang_case_case_tl  { #5 }
  }


