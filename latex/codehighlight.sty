%%%%%%%
\cs_new:Npn \__codehl_lang_case_split:NNNNN #1#2#3#4#5
  {
    \tl_set:Nn \l__codehl_lang_case_i_tl  { #5 }
    \int_if_zero:nTF { #1 }
      { \bool_set_false:N \l__codehl_lang_fmtless_bool }
      { \bool_set_true:N  \l__codehl_lang_fmtless_bool }
    \int_if_zero:nTF { #2 }
      { \bool_set_false:N \l__codehl_lang_defnestable_bool }
      { \bool_set_true:N  \l__codehl_lang_defnestable_bool }
    \int_if_zero:nTF {#3 }
      { \bool_set_false:N \l__codehl_lang_canhold_bool }
      { \bool_set_true:N  \l__codehl_lang_canhold_bool }
    \int_compare:nNnTF { #4 } = { 6 }
      {
        \bool_set_true:N  \l__codehl_lang_nestable_bool
        \bool_set_false:N \l__codehl_lang_col_at_bool
      }
      {
        \bool_set_false:N \l__codehl_lang_nestable_bool
        \int_compare:nNnTF { #4 } = { 3 }
          { \bool_set_true:N  \l__codehl_lang_col_at_bool }
          { \bool_set_false:N \l__codehl_lang_col_at_bool }
