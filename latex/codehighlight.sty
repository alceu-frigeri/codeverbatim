      { #1 } { #2 }
  }

\prg_new_protected_conditional:Npnn \__codehl_lang_load_if_predef:n #1 { TF }
  {
        \prop_get:NnNTF \g__codehl_predef_lang_prop
          { #1 } \l__codehl_tmpa_tl
          {
            \prop_if_in:NoTF \g__codehl_loaded_files_prop
              \l__codehl_tmpa_tl
              { }
              {
                \prop_gput:Non \g__codehl_loaded_files_prop
                  \l__codehl_tmpa_tl { }
                \file_input:V \l__codehl_tmpa_tl
              }
            \prg_return_true:
          }
          { \prg_return_false: }
  }

\cs_new_protected:Npn \codehl_lang_preload:n #1
  {
    \clist_map_inline:nn { #1 }
      {
        \__codehl_lang_load_if_predef:nTF { ##1 }
          { }
          { %err
            \msg_error:nnnn { codehl / lang } { pre def }
              { predef01 } { ##1 }
          }
      }
  }
\cs_set_eq:NN \hlLangLoad  \codehl_lang_preload:n


