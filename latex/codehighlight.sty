\__codehl_tok_keygen:nnn
  { string }
  {
      \__codehl_tok_fmt:o
        \l__codehl_tok_build_dlimit_tl
      \tl_clear:N \l__codehl_tok_build_dlimit_tl
  }
  {
      \__codehl_tok_test_space:
      \__codehl_tok_test_escape:
      \__codehl_tok_end_scan:
      \__codehl_tok_str_scan:
      \__codehl_tok_tr_scan:
  }


