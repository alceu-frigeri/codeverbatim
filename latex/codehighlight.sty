              {
                \bool_set_eq:cN { l__codehl_tok_style_ ##1 _bool } ##2
              }

            %%% this will cicle throughout all of them
            %%%
            \prop_map_inline:Nn \l__codehl_basefmt_cmds_prop
              { ##2 }


%%%
%%% TODO: this might be (probably IS) an error!
%%% _activ_lang_ might change AND not trigger this !!!
%%% same for _activ_keyset_
%%% Those two should get a cmd: on their own
%%%
            \tl_if_empty:NTF \l__codehl_tok_activ_lang_tl
              {
                \cs_set_eq:NN \__codehl_tok_inbase:    \prg_do_nothing
                \cs_set_eq:NN \__codehl_tok_inbasecmt: \prg_do_nothing
                \cs_set_eq:NN \__codehl_tok_inbasestr: \prg_do_nothing
                \cs_set_eq:NN \__codehl_tok_intag:     \prg_do_nothing
                \cs_set_eq:NN \__codehl_tok_intagcmt:  \prg_do_nothing
                \cs_set_eq:NN \__codehl_tok_intagstr:  \prg_do_nothing
                \cs_set_eq:NN \__codehl_tok_intr:      \prg_do_nothing
              }
              {
                \cs_set:Npe  \__codehl_tok_inbase:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _base_scan_dlimit: } }
                \cs_set:Npe  \__codehl_tok_inbasecmt:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _basecmt_scan_dlimit: } }
                \cs_set:Npe  \__codehl_tok_inbasestr:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _basestr_scan_dlimit: } }
                \cs_set:Npe  \__codehl_tok_intag:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _tag_scan_dlimit: } }
                \cs_set:Npe  \__codehl_tok_intagcmt:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _tagcmt_scan_dlimit: } }
                \cs_set:Npe  \__codehl_tok_intagstr:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _tagstr_scan_dlimit: } }
                \cs_set:Npe  \__codehl_tok_intr:
                  { \exp_not:c { __codehl_lang_ \l__codehl_tok_activ_lang_tl _tr_scan_dlimit: } }
              }

            \bool_lazy_or:nnTF { \tl_if_empty_p:N \l__codehl_tok_activ_keyset_tl } { \tl_if_empty_p:N \l__codehl_tok_activ_hlset_tl }
              {
                \cs_set:Npn \__codehl_tok_keyfmt_base:Ncoo
                  { \__codehl_tok_keyfmt_less:Ncoo }
                \cs_set:Npn \__codehl_tok_keyfmt_nested:Ncoo
                  { \__codehl_tok_keyfmt_less:Ncoo }

