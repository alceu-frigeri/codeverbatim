  \char_set_catcode_other:n { `\^^J }

  \cs_new:Npn \__codehl_tok_coffin_line_proc:w #1 ^^J
    {
      \quark_if_nil:nTF { #1 }
      {
        \bool_if:NTF \l__codehl_tok_lineset_bool
          {
            \__codehl_Brule_coffin_attach:

            \coffin_typeset:Nnnnn \l__codehl_line_coffin
              { l } { b } { 0pt } { 0pt }
  %\coffin_show:N \l__codehl_line_coffin
            \skip_vertical:n { 0pt } %{ -0.05ex }{ -0.05ex }
            \bool_set_false:N \l__codehl_tok_lineset_bool
          }
          { }
        \cs_set_eq:NN \__codehl_tok_next_line:w \prg_do_nothing:
      }
      {

        \bool_if:NTF \l__codehl_tok_lineset_bool
          {
            \coffin_typeset:Nnnnn \l__codehl_line_coffin
              { l } { b } { 0pt } { 0pt }
  %\coffin_show:N \l__codehl_line_coffin
            \skip_vertical:n { 0pt } %{ -0.05ex }
            \bool_set_false:N \l__codehl_tok_lineset_bool
          }
          { }
        \tl_clear:N \l__codehl_tok_build_line_tl
        \tl_clear:N \l__codehl_tok_build_keywd_tl

        \__codehl_tok_prepgobble:  %%% this sets \__codehl_tok_proc:N  from \__codehl_tok_start:N

        \int_incr:N \l__codehl_tok_line_int
        \int_zero:N \l__codehl_tok_col_int

        \__codehl_tok_proc:N #1 \q_nil %%%
        \__codehl_tok_disp_line:
      }
      \__codehl_tok_next_line:w
    }

  \cs_new:Npn \__codehl_tok_inline_proc:w #1 ^^J
    {
      \quark_if_nil:nTF { #1 }
      {
        \cs_set_eq:NN \__codehl_tok_next_line:w \prg_do_nothing:
      }
      {
        \tl_clear:N \l__codehl_tok_build_line_tl
        \tl_clear:N \l__codehl_tok_build_keywd_tl

        \__codehl_tok_prepgobble:   %%% this sets \__codehl_tok_proc:N  from \__codehl_tok_start:N

        \int_incr:N \l__codehl_tok_line_int
        \int_zero:N \l__codehl_tok_col_int

        \__codehl_tok_proc:N #1 \q_nil %%%
        \__codehl_tok_disp_line:
      }
      \__codehl_tok_next_line:w
    }

\group_end:


