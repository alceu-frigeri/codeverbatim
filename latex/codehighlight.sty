%%%%%%%
%%% states factory without keywd state
%%%%%%%

%%%%%%%
%%% #1 => \__codehl_tok_utf_<name>:
%%% #2 => \__codehl_tok_utf_<name>:
%%% #3 => eol building code
%%% #4 => base code
%%%%%%%
\cs_new_protected:Npn \__codehl_tok_gen:NNnn #1#2 #3#4
  {
    %%%
    %%% This is  __codehl_tok_utf_  <name> :
    %%%
    \cs_new:Npn #1 ##1
      {
        \if_meaning:w \q_nil ##1

          \tl_put_right:NV \l__codehl_tok_build_dlimit_tl \l__codehl_tok_build_utf_tl
          #3

          \bool_if:NTF \l__codehl_tok_upto_eol_bool
            {
              \__codehl_nested_pop:
            } { }
          \cs_set_eq:NN \__codehl_tok_proc:N \prg_do_nothing:

        \else:
          \if_int_compare:w ` ##1 > 127
            \tl_put_right:Nn \l__codehl_tok_build_utf_tl { ##1 }
            \if_int_compare:w ` ##1 > 191
              \__codehl_tok_col_count:
            \fi:
          \else:
            \tl_put_right:NV \l__codehl_tok_build_dlimit_tl \l__codehl_tok_build_utf_tl

            \cs_set:Npn
              \__codehl_tok_proc:N
              { #2 }

            \tl_set:Nn
              \l__codehl_tok_curr_token_tl
              { ##1 }
            \__codehl_tok_col_count:

            #4 % 'end' code

            \scan_stop:
          \fi:
        \fi:
        \__codehl_tok_proc:N
      }

    %%%
    %%% This is  __codehl_tok_  <name> :
    %%%
    \cs_new:Npn #2 ##1
      {
        \if_meaning:w \q_nil ##1

          #3

          \bool_if:NTF \l__codehl_tok_upto_eol_bool
            {
              \__codehl_nested_pop:
            } { }
          \cs_set_eq:NN \__codehl_tok_proc:N \prg_do_nothing:

        \else:
            \tl_set:Nn \l__codehl_tok_curr_token_tl { ##1 }
            \__codehl_tok_col_count:

            %%% utf test
            %%%
            \if_int_compare:w ` ##1 > 127
              \tl_set_eq:NN \l__codehl_tok_build_utf_tl \l__codehl_tok_curr_token_tl
              \cs_set:Npn \__codehl_tok_proc:N  { #1 }

              \__codehl_tok_scan_stop:w % jumping to \_codehl_scan_stop:
            \fi:

            #4 % 'end' code

            \scan_stop:
        \fi:
        \__codehl_tok_proc:N
      }
  }
\cs_generate_variant:Nn \__codehl_tok_gen:NNnn { cc }


