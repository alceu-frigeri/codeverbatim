                        { \exp_not:n { #2 } }   %% replaced code
                        {
                          {  }
                          {  }
                        }   %% { regex } { end patt }
                        { }                                 %%% "escape char" provision OR column (at col)
                      }
                  }
              }
          }
      }
      {
        \msg_error:nnneee { codehl / lang } { syntax err }
          { lang19b }
          \l__codehl_alias_lang_tl
          { \l__codehl_lang_opt_key_tl ~=~ \exp_not:n { #4 } }
          { \l__codehl_lang_opt_key_tl ~=~ { <org-str> } { <replacement> } }
