\prop_new_linked:N \g__codehl_predef_lang_prop
\prop_new_linked:N \g__codehl_predef_keyset_prop
\prop_new_linked:N \g__codehl_loaded_files_prop

\cs_new_protected:Npn \__codehl_lang_register:nn #1#2
  {
    \prop_gput:Nnn \g__codehl_predef_lang_prop
      { #1 } { #2 }
    \prop_gput:Nnn \g__codehl_predef_keyset_prop
      { #1 } { #2 }
  }
\cs_new_protected:Npn \__codehl_keyset_register:nn #1#2
  {
    \prop_gput:Nnn \g__codehl_predef_keyset_prop
      { #1 } { #2 }
  }

\cs_new_protected:Npn \codehl_lang_load:n #1
  {
    \clist_map_inline:nn { #1 }
      {
        \prop_get:NnNTF \g__codehl_predef_lang_prop
          { ##1 } \l__codehl_tmpa_tl
          {
            \prop_if_in:NoTF \g__codehl_loaded_files_prop
              \l__codehl_tmpa_tl
              { }
              {
                \prop_gput:Non \g__codehl_loaded_files_prop
                  \l__codehl_tmpa_tl { }
                \file_input:V \l__codehl_tmpa_tl
              }
          }
          { %err
            \msg_error:nnnn { codehl / lang } { pre def }
              { predef01 } { ##1 }
          }
      }
  }
\cs_set_eq:NN \hlLangLoad  \codehl_lang_load:n

\cs_new_protected:Npn \codehl_keyset_load:n #1
  {
    \clist_map_inline:nn { #1 }
      {
        \prop_get:NnNTF \g__codehl_predef_keyset_prop
          { ##1 } \l__codehl_tmpa_tl
          {
            \prop_if_in:NoTF \g__codehl_loaded_files_prop
              \l__codehl_tmpa_tl
              { }
              {
                \prop_gput:Non \g__codehl_loaded_files_prop
                  \l__codehl_tmpa_tl { }
                \file_input:V \l__codehl_tmpa_tl
              }
          }
          { %err
            \msg_error:nnnn { codehl / keyset } { pre def }
              { predef02 } { ##1 }
          }
      }
  }
\cs_set_eq:NN \hlKeysetLoad  \codehl_keyset_load:n

