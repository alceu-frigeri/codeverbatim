\cs_new_protected:Npn \codehl_lang_def:nn #1#2
  {
    \tl_set:Nn \l__codehl_alias_lang_tl { #1 }
    \__codehl_lang_if_def:nNTF
      { #1 } \l__codehl_def_lang_tl
      {
        \__codehl_set_build_false:no { lang } \l__codehl_def_lang_tl
      }
      {
        \tl_set:Nn \l__codehl_def_lang_tl { #1 }

        \prop_put:Nnn \l__codehl_sets_lang_prop
          { #1 }
          { #1 }

        %%% plain seq of derived ones from this
        \seq_new:c         { l__codehl_lang_ #1 _derived_seq }

        %%% those are the 'to be' remapped ones
        %%% _basedon_ contains just a plain list
        %%% _basedonB_ contains { <case> } { <int> } { <basedon> }
        \seq_new:c         { l__codehl_lang_ #1 _basedon_seq }
        \seq_new:c         { l__codehl_lang_ #1 _basedonB_seq } %% those are the 'to be' remapped ones

        \bool_new:c        { l__codehl_lang_ #1 _build_bool }

        %%% for the general 'set build false'
        %%% not used otherwise
        \tl_new:c          { l__codehl_lang_ #1 _clear_tl }

        %%% main pattern prop/seq
        %%% prop => { <begin-pattern> } => { <class> } { <rest> }
        %%% seq => { <begin-pattern> } preserving definition order
        \prop_new_linked:c { l__codehl_lang_ #1 _pattern_prop }
        \seq_new:c         { l__codehl_lang_ #1 _pattern_seq }

        %%% This is the effective _pattern (after build)...
        %%% also used by language_show:
        \prop_new_linked:c { l__codehl_lang_ #1 _build _pattern_prop }
        \seq_new:c         { l__codehl_lang_ #1 _build _pattern_seq }


        %% this will store common itens (digits, case ...)
        \prop_new_linked:c { l__codehl_lang_  #1 _keys_prop }
        \prop_new_linked:c { l__codehl_lang_  #1 _build_keys_prop } %% same, when building up

        %% this will store boolean itens IF (if digits set, if case set...)
        \prop_new_linked:c { l__codehl_lang_  #1 _bool_keys_prop }
        \prop_new_linked:c { l__codehl_lang_  #1 _build_bool_keys_prop } %% same, when building up
      }

    \keys_set:nn { codehl / lang } { #2 }
  }
