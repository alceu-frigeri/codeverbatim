\cs_new_protected:Npn \codehl_display:nn #1#2
  {
    \tl_if_blank:nTF { #2 }
      { }
      {
        %%% verifying if all sets are really pre-build... :/
        %%% might have changed after the last \codehl_settings:n
        %%% at least, _activ_ variables should be safe.
        %%%
        \tl_if_empty:NF \l__codehl_tok_activ_lang_tl
          { \__codehl_lang_build_ifnot:o \l__codehl_tok_activ_lang_tl }
        \tl_if_empty:NF \l__codehl_tok_activ_hlfmtset_tl
          { \__codehl_hlfmtset_build_ifnot:o \l__codehl_tok_activ_hlfmtset_tl }
        \tl_if_empty:NF \l__codehl_tok_activ_keyset_tl
          { \__codehl_keyset_build_ifnot:o \l__codehl_tok_activ_keyset_tl }

        \__codehl_basefmt_build_ifnot:on \l__codehl_tok_activ_basefmt_tl
          { \__codehl_basefmt_set_style: }


        %%% TODO
        %%% it might be worth (?!) to implement it like _basefmt_ (on change only)
        %%% but, it is just digits, case and alpha
        %%%
        \prop_map_inline:cn { l__codehl_lang_ \l__codehl_tok_activ_lang_tl _build_keys_prop }
          {
            \tl_set:cn { l__codehl_tok_lang_style_ ##1 _tl } { ##2 }
          }
        \prop_map_inline:cn { l__codehl_lang_ \l__codehl_tok_activ_lang_tl _build_bool_keys_prop }
          {
            \bool_set_eq:cN { l__codehl_tok_lang_style_ ##1 _bool } ##2
          }

        \group_begin:

          \cs_set_eq:NN \__codehl_basefmt_display_set:nn       \__codehl_basefmt_display_set_tok_style:nn
          \cs_set_eq:NN \__codehl_basefmt_display_bool_set:nn  \__codehl_basefmt_display_set_tok_bool_style:nn

          \tl_set_eq:NN \l__codehl_def_hlfmtset_tl \l__codehl_tok_activ_hlfmtset_tl
          \tl_set_eq:NN \l__codehl_def_keyset_tl   \l__codehl_tok_activ_keyset_tl

          \bool_set_true:N  \l__codehl_display_bool

          \keys_set:nn { codehl / display }
            { #1 }


          \bool_if:NTF \l__codehl_tok_inline_bool
            {
              \cs_set_eq:NN \__codehl_tok_set_line:    \__codehl_tok_inline_set:
              \cs_set_eq:NN \__codehl_tok_next_line:w  \__codehl_tok_inline_proc:w
              \tl_clear:N \l__codehl_tok_inline_aux_tl
            }
            {
              \__codehl_basefmt_set_dims:

              %%%%%%%
              %%% TODO: review the fixed spacing here...
              %%%%%%%
              \skip_vertical:n { 1ex }

              \cs_set_eq:NN \__codehl_tok_set_line:     \__codehl_tok_coffin_set_line:
              \cs_set_eq:NN \__codehl_tok_next_line:w   \__codehl_tok_coffin_line_proc:w
            }



          \cs_set:Npn \__codehl_tok_disp_line:
            { \__codehl_tok_set_line: }
          \cs_set_eq:NN \__codehl_tok_col_count:    \__codehl_tok_col_counting:

          \int_zero:N \l__codehl_tok_line_int

          \cs_set:Npn \__codehl_tok_start:N
            { \__codehl_tok_other:N  } %% it will (shall) handle just one token (byte) a time
          \cs_set_eq:NN
            \__codehl_tok_proc:N
            \__codehl_tok_start:N
          \cs_set_eq:NN
            \__codehl_tok_keyfmt_eff:Ncoo
            \__codehl_tok_keyfmt_base:Ncoo

          \cs_set_eq:NN
            \__codehl_tok_other_scan:
            \__codehl_tok_inbase:
          \cs_set_eq:NN
            \__codehl_tok_cmt_scan:
            \__codehl_tok_inbasecmt:
          \cs_set_eq:NN
            \__codehl_tok_str_scan:
            \__codehl_tok_inbasestr:
          \cs_set_eq:NN
            \__codehl_tok_tr_scan:
            \__codehl_tok_intr:

          \cs_set:Npe
            \__codehl_tok_scan_digits:N
            { \exp_not:c {  __codehl_lang_ \l__codehl_def_lang_tl _scan_digits:N } }
          \cs_set:Npe
            \__codehl_tok_scan_oletter:N
            { \exp_not:c {  __codehl_lang_ \l__codehl_def_lang_tl _scan_oletter:N } }

          \bool_if:NTF \l__codehl_tok_lang_style_case_bool
            {
              \cs_set:Npn \__codehl_tok_keywd_case:N
                { \__codehl_tok_keywd_casesensitive:N }
            }
            {
              \cs_set:Npn \__codehl_tok_keywd_case:N
                { \__codehl_tok_keywd_caseless:N }
            }

          \bool_if:NTF \l__codehl_tok_lang_style_keywd_bool
            {
              \cs_set:Npn \__codehl_tok_keyfmt_nested:Ncoo
                { \__codehl_tok_keyfmt:Ncoo }
            }
            {
              \cs_set:Npn \__codehl_tok_keyfmt_nested:Ncoo
                { \__codehl_tok_keyfmt_less:Ncoo }
            }


          \tl_set:Nn \l__codehl_tok_curr_tag_tl
            { keywd }

          \l__codehl_tok_style_basefmt_tl

          \bool_if:NTF \l__codehl_tok_shortverb_bool
            {
              \__codehl_tok_next_line:w #2 ^^J \q_nil ^^J
            }
            {
              \__codehl_tok_next_line:w #2 \q_nil ^^J
            }

        \group_end:
      }
  }
