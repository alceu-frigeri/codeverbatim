%%%%%%%
%%% \__codehl_tok_utf_dlimit_tex:N
%%% \__codehl_tok_dlimit_tex:N
%%%%%%%
\__codehl_tok_gen:nnn
  { dlimit_tex }
  {
      \__codehl_tok_fmt_retoken:o
        \l__codehl_tok_build_dlimit_tl
      \tl_clear:N \l__codehl_tok_build_dlimit_tl
  }
  {
      \__codehl_tok_end_scan:
            %%% no \penalty here... tex coding
      \tl_put_right:Nn \l__codehl_tok_build_dlimit_tl { #1 }
  }

%%%%%%%
%%% \__codehl_tok_utf_dlimit_discard:N
%%% \__codehl_tok_dlimit_discard:N
%%%%%%%
%%%%%%%
%%% Functionaly OK... but quite a few unnecessary assigments.
%%%%%%%
%%% TODO: use a dummy var instead of \l__codehl_tok_build_dlimit_tl
\__codehl_tok_gen:nnn
  { dlimit_discard }
  { }
  {
      \__codehl_tok_end_scan:
  }

%%%%%%%
%%% ==> re-defining __codehl_tok_utf_dlimit_discard:N to remove the unnecessary steps/assigments !
%%% in case of discard... there is no need to build up the line (which will be discarded anyway)
%%% breaking the factory pattern.
%%%%%%%
%%% why not just 'discard' everything?
%%% utf8 chars might be active (and the \peek_ahead commands can fail)
%%%
\cs_set:Npn  \__codehl_tok_utf_dlimit_discard:N #1
  {

    \if_meaning:w \q_nil #1
      \cs_set_eq:NN \__codehl_tok_proc:N \prg_do_nothing:
      \tl_clear:N \l__codehl_tok_build_dlimit_tl
    \else:
      \if_int_compare:w ` #1 > 127
      \else:
        \cs_set:Npn \__codehl_tok_proc:N
          { \__codehl_tok_dlimit_discard:N }

        \tl_set:Nn \l__codehl_tok_curr_token_tl { #1 }

        \__codehl_tok_end_scan:
        \scan_stop:
      \fi:
    \fi:
    \__codehl_tok_proc:N
  }


