\prop_new_linked:N \g__codehl_predef_lang_prop
\prop_new_linked:N \g__codehl_predef_keyset_prop
\prop_new_linked:N \g__codehl_loaded_files_prop

\cs_new_protected:Npn \__codehl_lang_register:nn #1#2
  {
    \prop_gput:Nnn \g__codehl_predef_lang_prop
      { #1 } { #2 }
    \prop_gput:Nnn \g__codehl_predef_keyset_prop
      { #1 } { #2 }
  }
\cs_new_protected:Npn \__codehl_keyset_register:nn #1#2
  {
    \prop_gput:Nnn \g__codehl_predef_keyset_prop
      { #1 } { #2 }
  }

\cs_new_protected:Npn \codehl_lang_load:n #1
  {
    \clist_map_inline:nn { #1 }
      {
        \prop_get:NnNTF \g__codehl_predef_lang_prop
          { ##1 } \l__codehl_tmpa_tl
          {
            \prop_if_in:NoTF \g__codehl_loaded_files_prop
              \l__codehl_tmpa_tl
              { }
              {
                \prop_gput:Non \g__codehl_loaded_files_prop
                  \l__codehl_tmpa_tl { }
                \file_input:V \l__codehl_tmpa_tl
              }
          }
          { %err
            \msg_error:nnnn { codehl / lang } { pre def }
              { predef01 } { ##1 }
          }
      }
  }
\cs_set_eq:NN \hlLangLoad  \codehl_lang_load:n

\cs_new_protected:Npn \codehl_keywdset_load:n #1
  {
    \clist_map_inline:nn { #1 }
      {
        \prop_get:NnNTF \g__codehl_predef_keyset_prop
          { ##1 } \l__codehl_tmpa_tl
          {
            \prop_if_in:NoTF \g__codehl_loaded_files_prop
              \l__codehl_tmpa_tl
              { }
              {
                \prop_gput:Non \g__codehl_loaded_files_prop
                  \l__codehl_tmpa_tl { }
                \file_input:V \l__codehl_tmpa_tl
              }
          }
          { %err
            \msg_error:nnnn { codehl / keyset } { pre def }
              { predef02 } { ##1 }
          }
      }
  }
\cs_set_eq:NN \hlKeywdsetLoad  \codehl_keywdset_load:n

%%%%%%%
%%% auxiliary, hack, commands
%%%
%%% \ProvidesExplFile :
%%%      it doesn't save the current code régime (like \ProvidesExplClass or \ProvidesExplPackage)
%%%      it doesn't restore the code régime at its end... :/
%%% The hack below saves and restore \l__kernel_expl_bool
%%%%%%%
\bool_new:N \l__codehl_preexpl_bool
\cs_new_protected:Npn \__codehl_explfile_test:
  {
    \bool_set_eq:NN \l__codehl_preexpl_bool  \l__kernel_expl_bool  %%% yeah, this shouldn't happen... but, ProvidesExplFile doesn't account for it... :/
    \bool_if:NTF \l__codehl_preexpl_bool
      { }
      { \ExplSyntaxOn }

  }
\cs_set_eq:NN \hlExplFileTest \__codehl_explfile_test:

\cs_new_protected:Npn \__codehl_explfile_out:
  {
    \bool_if:NTF \l__codehl_preexpl_bool
      { }
      { \ExplSyntaxOff }
  }
\cs_set_eq:NN \hlExplFileOut \__codehl_explfile_out:

