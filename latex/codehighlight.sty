      { - \l__codehl_tok_Fsep_dim - \l__codehl_tok_Rlinewidht_dim } { \l__codehl_tok_Tsep_dim }
    \cs_set_eq:NN \__codehl_set_Trule: \prg_do_nothing:
  }

\cs_new_protected:Npn \__codehl_attach_Brule:
