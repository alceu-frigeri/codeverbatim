%%%%%%%
%%% Global stack for recursive remapping
%%%%%%%
\RequirePackage{ tokglobalstack }
\globalstack_csnew:n    { __codehl_restack }
\cs_generate_variant:Nn  \__codehl_restack_gpush:n { e }


\cs_new_protected:Npn \__codehl_remapcount_push:
  {
    \__codehl_restack_gpush:e
      {
        \exp_not:N \int_set:Nn \exp_not:N \l__codehl_remapcount_int { \int_use:N \l__codehl_remapcount_int }
      }
  }

\cs_set_eq:NN \__codehl_remapcount_pop:   \__codehl_restack_gpop:


%%%%%%%
%%% remaping functions will be used in a expansion context.
%%% Do not protect them.
%%% 'default' ...
%%%%%%%
\cs_new:Npn \__codehl_class_remap_default:n #1
  { #1 }

\cs_new:Npn \__codehl_class_remap_n:n #1
  { \int_eval:w \l__codehl_remapcount_int + #1 }

\cs_new:Npn \__codehl_class_set:n #1
  {
    \if_int_compare:w #1 < 0
      #1
    \else:
      \int_use:N \l__codehl_remapcount_int
    \fi:
  }

\cs_set_eq:NN \__codehl_class_remap:n \__codehl_class_remap_default:n


\cs_new_protected:Npn \__codehl_build_remap:nnnnn #1#2#3#4#5
  {
    \int_add:Nn \l__codehl_remapcount_int { #4 }
    \if_int_compare:w #3 = 2
      \cs_set_eq:NN \__codehl_class_remap:n \__codehl_class_set:n
      \seq_map_inline:cn { l__codehl_ #1 _ #5 _basedonB_seq }
        { \__codehl_build_set:nnnnn { #1 } { #2 } ##1 }
    \else:
      \seq_map_inline:cn { l__codehl_ #1 _ #5 _basedonB_seq }
        {
          \__codehl_remapcount_push:
          \__codehl_build_remap:nnnnn { #1 } { #2 } ##1
          \__codehl_remapcount_pop:
        }
    \fi:

    \__codehl_build_cmd:nn { #2 } { #5 }

    \if_int_compare:w #3 = 2
      \cs_set_eq:NN \__codehl_class_remap:n \__codehl_class_remap_n:n
    \fi:
  }

\cs_new_protected:Npn \__codehl_build_set:nnnnn #1#2#3#4#5
  {
    \seq_map_inline:cn { l__codehl_ #1 _ #5 _basedonB_seq }
      { \__codehl_build_set:nnnnn { #1 } { #2 } ##1 }

    \__codehl_build_cmd:nn { #2 } { #5 }
  }

\cs_new_protected:Npn \__codehl_set_build_false:nn #1#2
  {
    \bool_if:cTF { l__codehl_ #1 _ #2 _build_bool }
      {
        \bool_set_false:c { l__codehl_ #1 _ #2 _build_bool }
        \use:c { l__codehl_ #1 _ #2 _clear_tl }
        \tl_clear:c { l__codehl_ #1 _ #2 _clear_tl }
      }
      { }

    \seq_if_empty:cTF { l__codehl_ #1 _ #2 _derived_seq }
      { }
      {
        \seq_map_inline:cn { l__codehl_ #1 _ #2 _derived_seq }
          { \__codehl_set_build_false:nn { #1 } { ##1 } }
      }
  }
\cs_generate_variant:Nn \__codehl_set_build_false:nn { no }

\cs_new_protected:Npn \__codehl_set_build_derived_false:nn #1#2
  {
    \seq_if_empty:cTF { l__codehl_ #1 _ #2 _derived_seq }
      { }
      {
        \seq_map_inline:cn { l__codehl_ #1 _ #2 _derived_seq }
          { \__codehl_set_build_false:nn { #1 } { ##1 } }
      }
  }
\cs_generate_variant:Nn \__codehl_set_build_derived_false:nn { no }

%%%%%%%
%%% generic based on
%%%%%%%
\regex_const:Nn \c__codehl_basedon_regex
  { ([RS])\[(\d+)\](.+) }


%%%
%%% what needs to be saved right before potentially loading a file (and triggering a nested definition)
%%% \l__codehl_basedon_tmp[a-c]_tl
%%% \l__codehl_def_[...]_tl
%%% \__codehl_basedon_AUX_if_def:nNTF
%%%
%%% TODO: others if 'the logic changes' :/
%%%
\globalstack_csnew:n    { __codehl_basedon_stack }
\cs_generate_variant:Nn  \__codehl_basedon_stack_gpush:n { e }

\prg_new_conditional:Npnn \__codehl_basedon_if_def:nN #1#2 { TF }
  {
    \__codehl_basedon_stack_gpush:e
      {
        %%% 'local' ones (not always needed)
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_basedon_tmpa_tl
          { \exp_not:o \l__codehl_basedon_tmpa_tl }
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_basedon_tmpb_tl
          { \exp_not:o \l__codehl_basedon_tmpb_tl }
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_basedon_tmpc_tl
          { \exp_not:o \l__codehl_basedon_tmpc_tl }

        %%% the loading file might contain more than one declaration
        %%% only one (at a time) really needed... which one is the nag.
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_def_lang_tl
          { \exp_not:o \l__codehl_def_lang_tl }
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_def_keyset_tl
          { \exp_not:o \l__codehl_def_keyset_tl }
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_def_hlset_tl
          { \exp_not:o \l__codehl_def_hlset_tl }
        \exp_not:N \tl_set:Nn
          \exp_not:N \l__codehl_def_basefmt_tl
          { \exp_not:o \l__codehl_def_basefmt_tl }

        %%% the current _if_def:nNTF
        \exp_not:N \cs_set:Npn
          \exp_not:N \__codehl_basedon_eff_if_def:nNTF
          { \exp_not:o \__codehl_basedon_eff_if_def:nNTF }
      }

    %%% _eff_if_def: might trigger a file loading (if pre-defs)
    \__codehl_basedon_eff_if_def:nNTF { #1 } #2
      {
        \__codehl_basedon_stack_gpop:
        \prg_return_true:
      }
      {
        \__codehl_basedon_stack_gpop:
        \prg_return_false:
      }
  }
\prg_generate_conditional_variant:Nnn \__codehl_basedon_if_def:nN { o } { TF }


\prg_new_protected_conditional:Npnn \__codehl_basedon_extract:nnn #1#2#3 { TF }
  {
    \regex_extract_all:NnNTF \c__codehl_basedon_regex { #3 } \l__codehl_basedon_tmpa_seq
      {
        \seq_pop_left:NN \l__codehl_basedon_tmpa_seq \l__codehl_basedon_tmpa_tl %% whole string, discarded
        \seq_pop_left:NN \l__codehl_basedon_tmpa_seq \l__codehl_basedon_tmpa_tl %% kind R or S
        \seq_pop_left:NN \l__codehl_basedon_tmpa_seq \l__codehl_basedon_tmpb_tl %% <int>
        \seq_pop_left:NN \l__codehl_basedon_tmpa_seq \l__codehl_basedon_tmpc_tl %% parent


        \__codehl_basedon_if_def:oNTF
          \l__codehl_basedon_tmpc_tl \l__codehl_basedon_tmpd_tl
%        \seq_if_exist:cTF { l__codehl_ #1 _ \l__codehl_basedon_tmpc_tl _derived_seq }
          {
            \str_case:onTF \l__codehl_basedon_tmpa_tl
              {
                { R }   %% remap case
                  {
                    \seq_put_right:co { l__codehl_ #1 _ #2 _basedon_seq } \l__codehl_basedon_tmpd_tl
                    \seq_put_right:ce { l__codehl_ #1 _ #2 _basedonB_seq } { { 1 } { \l__codehl_basedon_tmpb_tl } { \l__codehl_basedon_tmpd_tl } }
                    \seq_put_right:cn { l__codehl_ #1 _ \l__codehl_basedon_tmpd_tl _derived_seq } { #2 }
                  }
                { S }   %% set case
                  {
                    \seq_put_right:co { l__codehl_ #1 _ #2 _basedon_seq } \l__codehl_basedon_tmpd_tl
                    \seq_put_right:ce { l__codehl_ #1 _ #2 _basedonB_seq } { { 2 } { \l__codehl_basedon_tmpb_tl } { \l__codehl_basedon_tmpd_tl } }
                    \seq_put_right:cn { l__codehl_ #1 _ \l__codehl_basedon_tmpd_tl _derived_seq } { #2 }
                  }
              }
              { \prg_return_true: }
              {
                \msg_error:nnne { codehl / #1 } { invalid code }
                  { based01 } \l__codehl_basedon_tmpa_tl
                \prg_return_false:
              } %% err
          }
          {
            \msg_error:nnne { codehl / #1 } { non existant base }
              { based02 } \l__codehl_basedon_tmpc_tl
            \prg_return_false:
          }
      }
      {
        \__codehl_basedon_if_def:nNTF
          { #3 } \l__codehl_basedon_tmpd_tl
%        \seq_if_exist:cTF { l__codehl_ #1 _ #3 _derived_seq }
          {
            \seq_put_right:ce { l__codehl_ #1 _ #2 _basedon_seq } { \exp_not:o \l__codehl_basedon_tmpd_tl }
            \seq_put_right:ce { l__codehl_ #1 _ #2 _basedonB_seq } { { 0 } { 0 } { \exp_not:o \l__codehl_basedon_tmpd_tl } }
            \seq_put_right:cn { l__codehl_ #1 _ \l__codehl_basedon_tmpd_tl _derived_seq } { #2 }
            \prg_return_true:
          }
          {
            \msg_error:nnnn { codehl / #1 } { non existant base }
              { based03 } { #3 }
            \prg_return_false:
          }
      }
  }
\prg_generate_conditional_variant:Nnn  \__codehl_basedon_extract:nnn { no } { TF }


\cs_new_protected:Npn \__codehl_basedon:nnn #1#2#3
  {
    \seq_set_from_clist:Nn \l__codehl_basedon_tmp_seq
      { #3 }

    \seq_map_inline:cn { l__codehl_ #1 _ #2 _basedon_seq }
      {
        \seq_remove_all:cn { l__codehl_ #1 _ ##1 _derived_seq }
          { #2 }
      }
    \seq_clear:c  { l__codehl_ #1 _ #2 _basedon_seq } %% those are the 'to be' remapped ones
    \seq_clear:c  { l__codehl_ #1 _ #2 _basedonB_seq } %% those are the 'to be' remapped ones

    \seq_map_inline:Nn \l__codehl_basedon_tmp_seq
      {
        \__codehl_basedon_extract:nnnTF { #1 } { #2 } { ##1 }
          { } %% OK, no errors
          {
            %%% TODO: there was already an error mensage !
            \msg_error:nnnn { codehl /  #1  } { based on syntax }
              { based04 } { ##1 }
          }
      }
  }
\cs_generate_variant:Nn   \__codehl_basedon:nnn { no }


