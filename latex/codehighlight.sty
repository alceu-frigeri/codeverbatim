          \exp_not:N \exp_not:N \exp_not:n { #1 }
          \exp_not:N \cs_set:Npn
            \exp_not:N \__codehl_tok_proc:N
              {
                \exp_not:c
                  {
                    __codehl_lang_ \l__codehl_def_lang_tl _
