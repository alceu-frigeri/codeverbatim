                          { \exp_not:o \l__codehl_tmpab_tl }
                        }   %% { regex } { start patt }
                        { \exp_not:n { #2 } }   %% replaced code
                        {
                          {  }
                          {  }
                        }   %% { regex } { end patt }
                        { }                                 %%% "escape char" provision OR column (at col)
                      }
                  }
              }
              {
                \__codehl_lang_pattern_add:oee
                  \l__codehl_def_lang_tl
                  {
                    \exp_not:o \l__codehl_tmpab_tl
                  }
                  {
                      { \exp_not:n { replace* } }                 %% 'class' not affected by remap
                      {
                        %%%   <nestable><tag case>      . <inboth:2><col at:0> . <case:9>
                        { 10                            . 20                  . 9 }
                        { \exp_not:o \l__codehl_tmpa_tl }   %% 1st char (mark start)
                        {
