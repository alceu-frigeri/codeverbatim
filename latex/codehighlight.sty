%%%%%%%
%%% auxiliary, hack, commands
%%%
%%% \ProvidesExplFile :
%%%      it doesn't save the current code régime (like \ProvidesExplClass or \ProvidesExplPackage)
%%%      it doesn't restore the code régime at its end... :/
%%% The hack below saves and restore \l__kernel_expl_bool
%%%%%%%
\bool_new:N \l__codehl_preexpl_bool
\cs_new_protected:Npn \__codehl_explfile_test:
  {
    \bool_set_eq:NN \l__codehl_preexpl_bool  \l__kernel_expl_bool  %%% yeah, this shouldn't happen... but, ProvidesExplFile doesn't account for it... :/
    \bool_if:NTF \l__codehl_preexpl_bool
      { }
      { \ExplSyntaxOn }

  }
\cs_set_eq:NN \hlExplFileTest \__codehl_explfile_test:

\cs_new_protected:Npn \__codehl_explfile_out:
  {
    \bool_if:NTF \l__codehl_preexpl_bool
      { }
      { \ExplSyntaxOff }
  }
\cs_set_eq:NN \hlExplFileOut \__codehl_explfile_out:

