\keys_define:nn { codehl / base fmt }
  {
    based ~ on .code:n =
      {
        \bool_if:NTF \l__codehl_display_bool
          { %%% TODO err, not allowed
            \msg_error:nnnn { codehl / display } { based on err }
              { disp01 } { base~fmt }
          }
          {
            \__codehl_basedon:non { base fmt } \l__codehl_def_basefmt_tl { #1 }
            \__codehl_set_build_false:no { base fmt } \l__codehl_def_basefmt_tl
          }
      } ,
    based ~ on .value_required:n = true ,

    background .code:n =
      {
        \tl_if_blank:nTF { #1 }
          {
            \__codehl_basefmt_set_bool_style:nN
              { bckgnd color } \c_false_bool
          }
          {
            \__codehl_basefmt_set_bool_style:nN
              { bckgnd color } \c_true_bool
          }
        \__codehl_basefmt_set_style:nn
          { bckgnd color } { #1 }
      } ,
    background .value_required:n = true ,


    numbers .choices:nn =
      { none , left , right }
      {
        \__codehl_basefmt_set_style:nn
          { numbers at } { #1 }
        \if_case:w \l_keys_choice_int
        \or:
          \__codehl_basefmt_set_bool_style:nN
            { L numbers } \c_true_bool
          \__codehl_basefmt_set_bool_style:nN
            { numbers } \c_false_bool
        \or:
          \__codehl_basefmt_set_bool_style:nN
            { L numbers } \c_true_bool
          \__codehl_basefmt_set_bool_style:nN
            { numbers } \c_true_bool
        \or:
          \__codehl_basefmt_set_bool_style:nN
            { L numbers } \c_false_bool
          \__codehl_basefmt_set_bool_style:nN
            { numbers } \c_true_bool
        \fi:
      } ,
    numbers .value_required:n = true ,

    nesting .choices:nn =
      { none , default , ident , all }
      {
        \__codehl_basefmt_set_style:nV
          { nest idx } { \l_keys_choice_int }
        \__codehl_basefmt_set_style:nn
          { nesting } { #1 }
      } ,
    nesting .value_required:n = true ,

  }

