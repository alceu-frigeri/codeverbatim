\cs_new_protected:Npn \__codehl_lang_set_dlimit_end:nn #1#2
  {
    %%% dlimit end pattern (1st char)
    %%%
    \cs_set:cpe { __codehl_lang_ \l__codehl_def_lang_tl _
                  \int_use:N \l__codehl_lang_dlimit_cntA_int . \int_use:N \l__codehl_lang_dlimit_cntB_int
                  \l__codehl_lang_build_postfix_tl _scan_dlimit_end: }
      {
        \exp_not:N \if_charcode:w
          \exp_not:N \exp_not:o  \exp_not:N \l__codehl_tok_curr_token_tl
          \exp_not:N \exp_not:N \exp_not:n { #1 }
          \exp_not:N \cs_set:Npn
            \exp_not:N \__codehl_tok_proc:N
              {
                \exp_not:c
                  {
                    __codehl_lang_ \l__codehl_def_lang_tl _
                    \int_use:N \l__codehl_lang_dlimit_cntA_int . \int_use:N \l__codehl_lang_dlimit_cntB_int
                    \l__codehl_lang_build_postfix_tl _peek_end:N
                  }
              }
          \exp_not:N \__codehl_tok_scan_stop:w
        \exp_not:N \fi:
      }


    \tl_put_right:Nn \l__codehl_peek_build_endscanT_tl
      {
        \tl_clear:N \l__codehl_tok_build_dlimit_tl
         \__codehl_nested_pop:
         \__codehl_tok_proc:N
      }

    %%% dlimit end pattern (peeking)
    %%%
    \tl_if_empty:nTF { #2 }
      {
        \cs_set:cpe  {  __codehl_lang_ \l__codehl_def_lang_tl _
                        \int_use:N \l__codehl_lang_dlimit_cntA_int . \int_use:N \l__codehl_lang_dlimit_cntB_int
                        \l__codehl_lang_build_postfix_tl _peek_end:N }
          { \exp_not:o \l__codehl_peek_build_endscanT_tl }
      }
      {
        \regex_set:cn
          { l__codehl_lang_ \l__codehl_def_lang_tl _  \int_use:N \l__codehl_lang_dlimit_cntA_int . \int_use:N \l__codehl_lang_dlimit_cntB_int \l__codehl_lang_build_postfix_tl _end_regex }
          { #2 }
        \cs_set:cpe  {  __codehl_lang_ \l__codehl_def_lang_tl _
                        \int_use:N \l__codehl_lang_dlimit_cntA_int . \int_use:N \l__codehl_lang_dlimit_cntB_int
                        \l__codehl_lang_build_postfix_tl _peek_end:N }
          {
            \exp_not:N \peek_regex_remove_once:NTF
              \exp_not:c {  l__codehl_lang_ \l__codehl_def_lang_tl _
                            \int_use:N \l__codehl_lang_dlimit_cntA_int . \int_use:N \l__codehl_lang_dlimit_cntB_int
                            \l__codehl_lang_build_postfix_tl _end_regex }
              { \exp_not:o \l__codehl_peek_build_endscanT_tl }
              { \exp_not:o \l__codehl_peek_build_endscanF_tl }
          }
      }
  }
\cs_generate_variant:Nn \__codehl_lang_set_dlimit_end:nn { no }


