%%%%%%%
\prop_const_linked_from_keyval:Nn \c__codehl_basefmt_keys_name_prop
  {
    base fmt      = base ~ format       ,
    bckgnd color  = background          ,
    numbers fmt   = numbers ~ format    ,
    numbers at    = numbers             ,
    numbers sep   = numbers ~ sep       ,
    F sep         = frame ~ sep         ,
    L sep         = left ~ sep          ,
    R sep         = right ~ sep         ,
    T sep         = top ~ sep           ,
    B sep         = bottom ~ sep        ,
    T width       = text ~ width        ,
    W indent      = wrap ~ indent       ,
    R line width  = rule ~ width        ,
    gbbl          = gobble              ,
    R color       = rule ~ color        ,

