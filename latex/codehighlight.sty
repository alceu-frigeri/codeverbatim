\cs_new_protected:Npn \__codehl_attach_leftnum:
  {
    \vcoffin_set:Nne \l__codehl_linenum_coffin { \marginparwidth }
      {
        \exp_not:N \raggedleft \exp_not:N \strut
        \exp_not:o \l__codehl_tok_style_numbersfmt_tl
        { \exp_not:V \l__codehl_tok_line_int }
      }
    \coffin_attach:NnnNnnnn
      \l__codehl_line_coffin { l } { T }
      \l__codehl_linenum_coffin { r } { T }
      { - \l__codehl_tok_style_numberssep_tl } { 0pt }
  }

\cs_new_protected:Npn \__codehl_attach_rightnum:
  {
    \vcoffin_set:Nne \l__codehl_linenum_coffin { \marginparwidth }
      {
