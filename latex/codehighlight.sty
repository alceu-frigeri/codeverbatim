%%%%%%%
%%% package settings
%%%%%%%

\keys_define:nn { codehl / pkg settings }
  {

    suppress ~ notes .choices:nn =
      { true , false }
      {
        \if_case:w \l_keys_choice_int
        \or:
          \msg_redirect_name:nnn { codehl / lang } { info note } { none }
          \msg_redirect_name:nnn { codehl / keyset } { info note } { none }
          \msg_redirect_name:nnn { codehl / hlset } { info note } { none }
          \msg_redirect_name:nnn { codehl / basefmt } { info note } { none }
        \or:
          \msg_redirect_name:nnn { codehl / lang } { info note } { }
          \msg_redirect_name:nnn { codehl / keyset } { info note } { }
          \msg_redirect_name:nnn { codehl / hlset } { info note } { }
          \msg_redirect_name:nnn { codehl / basefmt } { info note } { }
        \fi:
      } ,
    suppress ~ notes .default:n = true ,
  }

\cs_new_protected:Npn \codehl_pkg_settings:n #1
  {
    \keys_set:nn { codehl / pkg settings } { #1 }
  }
\cs_set_eq:NN \hlPackSettings \codehl_pkg_settings:n


