%%%%%%%
%%% <states> factory with keywd state
%%%%%%%

%%%%%%%
%%% #1 => \__codehl_tok_utf_<name>:
%%% #2 => \__codehl_tok_<name>:
%%% #3 => \__codehl_tok_keywd_<name>:
%%% #4 => eol building code
%%% #5 => base code
%%%%%%%
\cs_new_protected:Npn \__codehl_tok_keygen:NNNnn #1#2#3 #4#5
  {
    %%%
    %%% This is  __codehl_tok_utf_  <name> :
    %%%
    \cs_new:Npn #1 ##1
      {
        \if_meaning:w \q_nil ##1

          \tl_put_right:NV \l__codehl_tok_build_dlimit_tl \l__codehl_tok_build_utf_tl
          #4

          \bool_if:NTF \l__codehl_tok_upto_eol_bool
            {
              \__codehl_nested_pop:
            } { }
          \cs_set_eq:NN \__codehl_tok_proc:N \prg_do_nothing:

        \else:
          \if_int_compare:w ` ##1 > 127
            \tl_put_right:Nn \l__codehl_tok_build_utf_tl { ##1 }
            \if_int_compare:w ` ##1 > 191
              \__codehl_tok_col_count:
            \fi:
          \else:
            \tl_put_right:NV \l__codehl_tok_build_dlimit_tl \l__codehl_tok_build_utf_tl
            \tl_put_right:Nn \l__codehl_tok_build_dlimit_tl { \__codehl_penalty: }
            \cs_set:Npn \__codehl_tok_proc:N  { #2 }

            \tl_set:Nn \l__codehl_tok_curr_token_tl { ##1 }
            \__codehl_tok_col_count:

            #5 % 'end' code

            \if_catcode:w \exp_not:N ##1 \c_catcode_letter_token
              \tl_set:Nn    \l__codehl_tok_build_keywd_tl ##1
              \tl_set_eq:NN \l__codehl_tok_curr_ident_tl \l__codehl_tok_curr_tag_tl
              \cs_set:Npn \__codehl_tok_proc:N  { #3 }

            \else:
              \__codehl_tok_scan_oletter:N ##1

              \tl_put_right:Nn \l__codehl_tok_build_dlimit_tl { ##1 \__codehl_penalty: }
            \fi:

            \scan_stop:
          \fi:
        \fi:

        \__codehl_tok_proc:N
      }

    %%%
    %%% This is  __codehl_tok_  <name> :
    %%%
    \cs_new:Npn #2 ##1
      {
        \if_meaning:w \q_nil ##1

          #4

          \bool_if:NTF \l__codehl_tok_upto_eol_bool
            {
              \__codehl_nested_pop:
            }
            { }
          \cs_set_eq:NN \__codehl_tok_proc:N \prg_do_nothing:

        \else:
            \tl_set:Nn \l__codehl_tok_curr_token_tl { ##1 }
            \__codehl_tok_col_count:

            %%% utf test
            %%%
            \if_int_compare:w ` ##1 > 127
              \tl_set_eq:NN \l__codehl_tok_build_utf_tl \l__codehl_tok_curr_token_tl
              \cs_set:Npn \__codehl_tok_proc:N
                { #1 }

              \__codehl_tok_scan_stop:w % jumping to \scan_stop:
            \fi:

            #5 % 'end' code

            \if_catcode:w \exp_not:N ##1 \c_catcode_letter_token
              \tl_set:Nn    \l__codehl_tok_build_keywd_tl ##1
              \tl_set_eq:NN \l__codehl_tok_curr_ident_tl \l__codehl_tok_curr_tag_tl
              \cs_set:Npn \__codehl_tok_proc:N  { #3 }
            \else:
              \__codehl_tok_scan_oletter:N ##1
              \tl_put_right:Nn \l__codehl_tok_build_dlimit_tl { ##1 \__codehl_penalty: }
            \fi:

            \scan_stop:
        \fi:
        \__codehl_tok_proc:N
      }

    %%%
    %%% This is  __codehl_tok_keywd_  <name> :
    %%%
    \cs_new:Npn #3 ##1
      {
        \if_meaning:w \q_nil ##1

          \__codehl_tok_keyfmt_eff:Ncoo
            \l__codehl_tok_build_dlimit_tl
            { l__codehl_keyset_ \l__codehl_tok_activ_keyset_tl  _  \l__codehl_tok_curr_ident_tl _ \__codehl_tok_keywd_case:N \l__codehl_tok_build_keywd_tl _tl }
            \l__codehl_tok_build_prekeywd_tl
            \l__codehl_tok_build_keywd_tl
          \tl_clear:N \l__codehl_tok_build_keywd_tl
          \tl_clear:N \l__codehl_tok_build_prekeywd_tl

          #4

          \bool_if:NTF \l__codehl_tok_ident_bool
            {
              \__codehl_nested_pop:
              \bool_set_false:N \l__codehl_tok_ident_bool
            } { }

          \bool_if:NTF \l__codehl_tok_upto_eol_bool
            {
              \__codehl_nested_pop:
            } { }

          \cs_set_eq:NN \__codehl_tok_proc:N \prg_do_nothing:

        \else:

          \__codehl_tok_col_count:
          \if_catcode:w \exp_not:N ##1 \c_catcode_letter_token
            \tl_put_right:Nn \l__codehl_tok_build_keywd_tl ##1
          \else:

            \__codehl_tok_scan_digits:N ##1

            \__codehl_tok_keyfmt_eff:Ncoo
              \l__codehl_tok_build_dlimit_tl
              { l__codehl_keyset_ \l__codehl_tok_activ_keyset_tl  _  \l__codehl_tok_curr_ident_tl _ \__codehl_tok_keywd_case:N \l__codehl_tok_build_keywd_tl _tl }
              \l__codehl_tok_build_prekeywd_tl
              \l__codehl_tok_build_keywd_tl
            \tl_clear:N \l__codehl_tok_build_prekeywd_tl
            \tl_clear:N \l__codehl_tok_build_keywd_tl

            \cs_set:Npn \__codehl_tok_proc:N  { #2 }

            \bool_if:NTF \l__codehl_tok_ident_bool
              {
                \__codehl_nested_pop:
                \bool_set_false:N \l__codehl_tok_ident_bool
              } { }

            \tl_set:Nn \l__codehl_tok_curr_token_tl { ##1 }

            %%% utf test
            %%%
            \if_int_compare:w ` ##1 > 127
              \tl_set_eq:NN \l__codehl_tok_build_utf_tl \l__codehl_tok_curr_token_tl
              \cs_set:Npn \__codehl_tok_proc:N  { #1 }
              \__codehl_tok_scan_stop:w % jumping to \scan_stop:
            \fi:

            #5

            \tl_put_right:Nn \l__codehl_tok_build_dlimit_tl { ##1 \__codehl_penalty: }  %%% ARGH! look above (...if_catcode... last assigment...)
            \scan_stop:
          \fi:
        \fi:
        \__codehl_tok_proc:N
      }
  }
\cs_generate_variant:Nn \__codehl_tok_keygen:NNNnn { ccc }


